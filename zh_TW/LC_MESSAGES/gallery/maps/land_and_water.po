#: ../../../gallery/maps/land_and_water.rst:22
msgid "Color land and water"
msgstr ""

#: ../../../gallery/maps/land_and_water.rst:24
msgid ""
"The ``land`` and ``water`` parameters of :meth:`pygmt.Figure.coast` specify "
"a color to fill in the land and water masses, respectively. There are many :"
"gmt-docs:`color codes in GMT <gmtcolors.html>`, including standard GMT color "
"names (like ``\"skyblue\"``), R/G/B levels (like ``\"0/0/255\"``), a hex "
"value (like ``\"#333333\"``), and a gray level (like ``\"gray50\"``)."
msgstr ""

#: ../../../gallery/maps/land_and_water.rst:32
msgid ""
"import pygmt\n"
"\n"
"fig = pygmt.Figure()\n"
"# Make a global Mollweide map with automatic ticks\n"
"fig.basemap(region=\"g\", projection=\"W15c\", frame=True)\n"
"# Plot the land as light gray, and the water as sky blue\n"
"fig.coast(land=\"#666666\", water=\"skyblue\")\n"
"fig.show()"
msgstr ""

