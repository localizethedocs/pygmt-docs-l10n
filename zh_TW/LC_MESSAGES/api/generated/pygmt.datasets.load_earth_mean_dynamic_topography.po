#: pygmt.datasets.earth_mean_dynamic_topography.load_earth_mean_dynamic_topography:34
msgid ""
"The grid resolution. The suffix ``d`` and ``m`` stand for arc-degrees and "
"arc-minutes. Note that ``\"07m\"`` refers to a resolution of 7.5 arc-minutes."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/datasets/earth_mean_dynamic_topography.py:docstring
#: of
#: pygmt.datasets.earth_mean_dynamic_topography.load_earth_mean_dynamic_topography:37
msgid ""
"The subregion of the grid to load, in the form of a sequence [*xmin*, "
"*xmax*, *ymin*, *ymax*] or an ISO country code."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/datasets/earth_mean_dynamic_topography.py:docstring
#: of
#: pygmt.datasets.earth_mean_dynamic_topography.load_earth_mean_dynamic_topography:40
msgid ""
"Grid registration type. Either ``\"pixel\"`` for pixel registration or "
"``\"gridline\"`` for gridline registration."
msgstr ""

