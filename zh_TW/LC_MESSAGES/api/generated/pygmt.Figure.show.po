#: ../../../api/generated/pygmt.Figure.show.rst:2
msgid "pygmt.Figure.show"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/figure.py:docstring
#: of pygmt.figure.Figure.show:1
msgid "Display a preview of the figure."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/figure.py:docstring
#: of pygmt.figure.Figure.show:3
msgid ""
"Inserts the preview in the Jupyter notebook output if available, otherwise "
"opens it in the default viewer for your operating system (falls back to the "
"default web browser)."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/figure.py:docstring
#: of pygmt.figure.Figure.show:7
msgid ""
"Use :func:`pygmt.set_display` to select the default display method "
"(``\"notebook\"``, ``\"external\"``, ``\"none\"`` or ``None``)."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/figure.py:docstring
#: of pygmt.figure.Figure.show:10
msgid ""
"The ``method`` parameter allows to override the default display method for "
"the current figure. The parameters ``dpi`` and ``width`` can be used to "
"control the resolution and dimension of the figure in the notebook."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/figure.py:docstring
#: of pygmt.figure.Figure.show:14
msgid ""
"The external viewer can be disabled by setting the environment variable :"
"term:`PYGMT_USE_EXTERNAL_DISPLAY` to ``\"false\"``. This is useful when "
"running tests and building the documentation to avoid popping up windows."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/figure.py:docstring
#: of pygmt.figure.Figure.show:18
msgid ""
"The external viewer does not block the current process, thus it's necessary "
"to suspend the execution of the current process for a short while after "
"launching the external viewer, so that the preview image won't be deleted "
"before the external viewer tries to open it. Set the ``waiting`` parameter "
"to a larger number if the image viewer on your computer is slow to open the "
"figure."
msgstr ""

#: ../../../api/generated/pygmt.Figure.show.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/figure.py:docstring
#: of pygmt.figure.Figure.show:25
msgid ""
"The method to display the current image preview. Choose from:  - "
"``\"external\"``: External PDF preview using the default PDF viewer - "
"``\"notebook\"``: Inline PNG preview in the current notebook - ``\"none\"``: "
"Disable image preview - ``None``: Reset to the default display method  The "
"default display method is ``\"external\"`` in Python consoles and "
"``\"notebook\"`` in Jupyter notebooks, but can be changed by :func:`pygmt."
"set_display`."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/figure.py:docstring
#: of pygmt.figure.Figure.show:25
msgid "The method to display the current image preview. Choose from:"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/figure.py:docstring
#: of pygmt.figure.Figure.show:27
msgid "``\"external\"``: External PDF preview using the default PDF viewer"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/figure.py:docstring
#: of pygmt.figure.Figure.show:28
msgid "``\"notebook\"``: Inline PNG preview in the current notebook"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/figure.py:docstring
#: of pygmt.figure.Figure.show:29
msgid "``\"none\"``: Disable image preview"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/figure.py:docstring
#: of pygmt.figure.Figure.show:30
msgid "``None``: Reset to the default display method"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/figure.py:docstring
#: of pygmt.figure.Figure.show:32
msgid ""
"The default display method is ``\"external\"`` in Python consoles and "
"``\"notebook\"`` in Jupyter notebooks, but can be changed by :func:`pygmt."
"set_display`."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/figure.py:docstring
#: of pygmt.figure.Figure.show:36
msgid "The image resolution (dots per inch) in Jupyter notebooks."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/figure.py:docstring
#: of pygmt.figure.Figure.show:38
msgid "The image width (in pixels) in Jupyter notebooks."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/figure.py:docstring
#: of pygmt.figure.Figure.show:40
msgid ""
"Suspend the execution of the current process for a given number of seconds "
"after launching an external viewer. Only works if ``method=\"external\"``."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/figure.py:docstring
#: of pygmt.figure.Figure.show:43
msgid ""
"Additional keyword arguments passed to :meth:`pygmt.Figure.psconvert`. Valid "
"parameters are ``gs_path``, ``gs_option``, ``resize``, ``bb_style``, and "
"``verbose``."
msgstr ""

