#: ../../../../examples/tutorials/basics/text.py:713
msgid ""
"<div class=\"sphx-glr-thumbcontainer\" tooltip=\"The main advantage of this "
"projection is that distances from the projection center are displayed in "
"correct proportions. Also directions measured from the projection center are "
"correct. It is very useful for a global view on locations that lie within a "
"certain distance or for comparing distances of different locations relative "
"to the projection center.\">"
msgstr ""

#: ../../../../examples/tutorials/basics/text.py:722
