msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/inset.py:docstring
#: of pygmt.src.inset.inset:37
msgid ""
"Width and height of the inset. Width must be specified unless ``projection`` "
"and ``region`` are given, and height is set to be equal to width if not "
"specified."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/inset.py:docstring
#: of pygmt.src.inset.inset:40
msgid ""
"Draw a background box behind the inset. If set to ``True``, a simple "
"rectangular box is drawn using :gmt-term:`MAP_FRAME_PEN`. To customize the "
"box appearance, pass a :class:`pygmt.params.Box` object to control style, "
"fill, pen, and other box properties."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/inset.py:docstring
#: of pygmt.src.inset.inset:44
msgid ""
"This is clearance that is added around the inside of the inset. Plotting "
"will take place within the inner region only. The margins can be a single "
"value, a pair of values separated (for setting separate horizontal and "
"vertical margins), or the full set of four margins (for setting separate "
"left, right, bottom, and top margins). When passing multiple values, it can "
"be either a list or a string with the values separated by forward slashes "
"[Default is no margins]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/inset.py:docstring
#: of pygmt.src.inset.inset:54
msgid ""
"Do **not** clip features extruding outside the inset frame boundaries "
"[Default is ``False``]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/inset.py:docstring
#: of pygmt.src.inset.inset:57
msgid ""
"*projcode*\\[*projparams*/]\\ *width*\\|\\ *scale*. Select map :doc:"
"`projection </projections/index>`."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/inset.py:docstring
#: of pygmt.src.inset.inset:59
msgid ""
"[*xmin*, *xmax*, *ymin*, *ymax*] or *xmin/xmax/ymin/ymax*\\ [**+r**]"
"[**+u**\\ *unit*]. Specify the :doc:`region </tutorials/basics/regions>` of "
"interest."
msgstr ""

