#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/inset.py:docstring
#: of pygmt.src.inset.inset:4
msgid ""
"This method carves out a sub-region of the current plot canvas and restrict "
"further plotting to that section of the canvas. Plotting methods that are "
"called within the context manager are added to the inset figure."
msgstr ""

