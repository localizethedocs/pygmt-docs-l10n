msgid "pygmt.clib.Session.put\\_vector"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.put_vector:1
msgid "Attach a 1-D numpy array as a column on a GMT dataset."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.put_vector:3
msgid ""
"Use this function to attach numpy array data to a GMT dataset and pass it to "
"GMT modules. Wraps ``GMT_Put_Vector``."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.put_vector:6
msgid ""
"The dataset must be created by :meth:`pygmt.clib.Session.create_data` first "
"with ``family=\"GMT_IS_DATASET|GMT_VIA_VECTOR\"``."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.put_vector:9
msgid ""
"Not all numpy dtypes are supported, only: int8, int16, int32, int64, "
"longlong, uint8, uint16, uint32, uint64, ulonglong, float32, float64, "
"str\\_, datetime64, and timedelta64."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.put_vector:14
msgid ""
"The numpy array must be C contiguous in memory. Use :func:`numpy."
"ascontiguousarray` to make sure your vector is contiguous (it won't copy if "
"it already is)."
msgstr ""

#: ../../../api/generated/pygmt.clib.Session.put_vector.rst:0
msgid "Parameters"
msgstr "參數"

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.put_vector:19
msgid ""
"The ctypes void pointer to a ``GMT_VECTOR`` data container. Create it with :"
"meth:`pygmt.clib.Session.create_data`."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.put_vector:22
msgid "The column number of this vector in the dataset (starting from 0)."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.put_vector:24
msgid ""
"The array that will be attached to the dataset. Must be a 1-D C contiguous "
"array."
msgstr ""

