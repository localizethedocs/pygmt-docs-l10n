#: ../../../projections/azim/azim_gnomonic.rst:22
msgid "Gnomonic projection"
msgstr ""

#: ../../../projections/azim/azim_gnomonic.rst:24
msgid ""
"The point of perspective of the gnomonic projection lies at the center of "
"the Earth. As a consequence great circles (orthodromes) on the surface of "
"the Earth are displayed as straight lines, which makes it suitable for "
"distance estimation for navigational purposes. It is neither conformal nor "
"equal-area and the distortion increases greatly with distance to the "
"projection center. It follows that the scope of application is restricted to "
"a small area around the projection center (at a maximum of 60°)."
msgstr ""

#: ../../../projections/azim/azim_gnomonic.rst:32
msgid ""
"**f**\\ *lon0/lat0*\\ [*/horizon*]\\ */scale* or **F**\\ *lon0/lat0*\\ [*/"
"horizon*]\\ */width*"
msgstr ""

#: ../../../projections/azim/azim_gnomonic.rst:35
msgid "**f** or **F**: Sets the projection type."
msgstr ""

#: ../../../projections/azim/azim_gnomonic.rst:36
msgid "*lon0/lat0*: Sets the projection center."
msgstr ""

#: ../../../projections/azim/azim_gnomonic.rst:37
msgid ""
"*horizon*: Sets the maximum distance from the projection center in degrees "
"(< 90°) [Optional, default is 60°]."
msgstr ""

#: ../../../projections/azim/azim_gnomonic.rst:39
msgid "*scale* or *width*: Sets the map size."
msgstr ""

#: ../../../projections/azim/azim_gnomonic.rst:43
msgid ""
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"fig.coast(\n"
"    region=\"g\",\n"
"    projection=\"F-90/15/12c\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
"    land=\"khaki\",\n"
"    water=\"white\",\n"
")\n"
"fig.show()"
msgstr ""

