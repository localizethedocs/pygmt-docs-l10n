#: ../../../projections/cyl/cyl_equal_area.rst:22
msgid "Cylindrical equal-area projection"
msgstr ""

#: ../../../projections/cyl/cyl_equal_area.rst:24
msgid ""
"This cylindrical projection is actually several projections, depending on "
"what latitude is selected as the standard parallel. However, they are all "
"equal area and hence non-conformal. All meridians and parallels are straight "
"lines."
msgstr ""

#: ../../../projections/cyl/cyl_equal_area.rst:28
msgid "**y**\\ *lon0/lat0*\\ */scale* or **Y**\\ *lon0/lat0*\\ */width*"
msgstr ""

#: ../../../projections/cyl/cyl_equal_area.rst:30
msgid ""
"The projection is set with **y** or **Y**. The projection center is set by "
"*lon0/lat0*, and the figure size is set with *scale* or *width*."
msgstr ""

#: ../../../projections/cyl/cyl_equal_area.rst:35
msgid ""
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"# Use region \"d\" to specify global region (-180/180/-90/90)\n"
"fig.coast(\n"
"    region=\"d\",\n"
"    projection=\"Y35/30/12c\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
"    land=\"gray80\",\n"
"    water=\"steelblue\",\n"
")\n"
"fig.show()"
msgstr ""

