#: ../../../projections/cyl/cyl_stereographic.rst:22
msgid "Cylindrical stereographic projection"
msgstr ""

#: ../../../projections/cyl/cyl_stereographic.rst:24
msgid ""
"The cylindrical stereographic projections are certainly not as notable as "
"other cylindrical projections, but are still used because of their relative "
"simplicity and their ability to overcome some of the downsides of other "
"cylindrical projections, like extreme distortions of the higher latitudes. "
"The stereographic projections are perspective projections, projecting the "
"sphere onto a cylinder in the direction of the antipodal point on the "
"equator. The cylinder crosses the sphere at two standard parallels, "
"equidistant from the equator."
msgstr ""

#: ../../../projections/cyl/cyl_stereographic.rst:33
msgid ""
"**cyl_stere**/\\ [*lon0*/\\ [*lat0*/]]\\ *scale* or **Cyl_stere**/\\ [*lon0*/"
"\\ [*lat0*/]]\\ *width*"
msgstr ""

#: ../../../projections/cyl/cyl_stereographic.rst:36
msgid "**cyl_stere** or **Cyl_stere**: Sets the projection type."
msgstr ""

#: ../../../projections/cyl/cyl_stereographic.rst:37
msgid "*lon0*: Sets the central meridian [Optional]."
msgstr ""

#: ../../../projections/cyl/cyl_stereographic.rst:38
msgid ""
"*lat0*: Sets the standard parallel [Optional]. When supplied, *lon0* must be "
"supplied as well."
msgstr ""

#: ../../../projections/cyl/cyl_stereographic.rst:40
msgid "*scale* or *width*: Sets the map size."
msgstr ""

#: ../../../projections/cyl/cyl_stereographic.rst:42
msgid "The standard parallel is typically one of these (but can be any value):"
msgstr ""

#: ../../../projections/cyl/cyl_stereographic.rst:44
msgid "66.159467 - Miller's modified Gall"
msgstr ""

#: ../../../projections/cyl/cyl_stereographic.rst:45
msgid "55 - Kamenetskiy's First"
msgstr ""

#: ../../../projections/cyl/cyl_stereographic.rst:46
msgid "45 - Gall's Stereographic"
msgstr ""

#: ../../../projections/cyl/cyl_stereographic.rst:47
msgid "30 - Bolshoi Sovietskii Atlas Mira or Kamenetskiy's Second"
msgstr ""

#: ../../../projections/cyl/cyl_stereographic.rst:48
msgid "0 - Braun's Cylindrical"
msgstr ""

#: ../../../projections/cyl/cyl_stereographic.rst:52
msgid ""
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"fig.coast(\n"
"    region=\"g\",\n"
"    projection=\"Cyl_stere/30/-20/12c\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
"    land=\"gray80\",\n"
"    water=\"steelblue\",\n"
")\n"
"fig.show()"
msgstr ""

