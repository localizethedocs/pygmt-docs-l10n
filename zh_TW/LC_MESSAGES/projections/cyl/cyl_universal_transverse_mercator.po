msgstr ""

#: ../../../projections/cyl/cyl_universal_transverse_mercator.rst:60
msgid ""
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"# UTM Zone is set to 52R\n"
"fig.coast(\n"
"    region=[127.5, 128.5, 26, 27],\n"
"    projection=\"U52R/12c\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
"    land=\"gray80\",\n"
"    water=\"steelblue\",\n"
")\n"
"fig.show()"
msgstr ""

