#: ../../../gallery/embellishments/timestamp.rst:22
msgid "Timestamp"
msgstr ""

#: ../../../gallery/embellishments/timestamp.rst:24
msgid ""
"The :meth:`pygmt.Figure.timestamp` method can draw the GMT timestamp logo on "
"the plot. The timestamp will always be shown relative to the Bottom Left "
"(BL) corner of the plot. By default, the ``offset`` and ``justify`` "
"parameters are set to ``(\"-54p\", \"-54p\")`` (x-, y-directions) and "
"``\"BL\"`` (Bottom Left), respectively."
msgstr ""

#: ../../../gallery/embellishments/timestamp.rst:31
msgid ""
"import os\n"
"\n"
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"fig.basemap(region=[20, 30, -10, 10], projection=\"X10c/5c\", frame=True)\n"
"fig.timestamp()\n"
"fig.show()"
msgstr ""

#: ../../../gallery/embellishments/timestamp.rst:46
msgid ""
"Additionally, a custom label can be added via the ``label`` parameter. The "
"font can be defined via the ``font`` parameter and the timestamp string "
"format via ``timefmt``."
msgstr ""

#: ../../../gallery/embellishments/timestamp.rst:51
msgid ""
"os.environ[\"TZ\"] = \"Pacific/Honolulu\"  # optionally set the time zone\n"
"\n"
"fig = pygmt.Figure()\n"
"fig.coast(\n"
"    region=\"d\",\n"
"    projection=\"H10c\",\n"
"    land=\"black\",\n"
"    water=\"cornsilk\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
")\n"
"fig.timestamp(\n"
"    label=\"Powered by PyGMT\",\n"
"    justify=\"TL\",\n"
"    font=\"Times-Bold\",\n"
"    timefmt=\"%Y-%m-%dT%H:%M:%S%z\",\n"
")\n"
"fig.show()"
msgstr ""

