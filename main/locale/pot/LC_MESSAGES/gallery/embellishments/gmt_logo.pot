#: ../../../gallery/embellishments/gmt_logo.rst:24
msgid ""
"The :meth:`pygmt.Figure.logo` method allows to place the GMT logo on a plot. "
"For plotting the PyGMT logo, see :doc:`PyGMT logo </gallery/embellishments/"
"pygmtlogo>`."
msgstr ""

#: ../../../gallery/embellishments/gmt_logo.rst:29
msgid ""
"import pygmt\n"
"from pygmt.params import Position\n"
"\n"
"fig = pygmt.Figure()\n"
"fig.basemap(region=[0, 10, 0, 2], projection=\"X6c\", frame=True)\n"
"\n"
"# Add the GMT logo in the Top Right (TR) corner of the current plot, scaled "
"up to be 3\n"
"# centimeters wide and offset by 0.3 cm in x-direction and 0.6 cm in y-"
"direction.\n"
"fig.logo(position=Position(\"TR\", offset=(0.3, 0.6)), width=\"3c\")\n"
"fig.show()"
msgstr ""

