#: ../../../gallery/images/rgb_image.rst:22
msgid "RGB image"
msgstr ""

#: ../../../gallery/images/rgb_image.rst:24
msgid ""
"The :meth:`pygmt.Figure.grdimage` method can be used to plot Red, Green, "
"Blue (RGB) images, or any 3-band false color combination. Here, we'll use :"
"py:func:`rioxarray.open_rasterio` to read a GeoTIFF file into an :class:"
"`xarray.DataArray` format, and plot it on a map."
msgstr ""

#: ../../../gallery/images/rgb_image.rst:29
msgid ""
"The example below shows a Worldview 2 satellite image over `Lāhainā, Hawaiʻi "
"during the August 2023 wildfires <https://en.wikipedia.org/"
"wiki/2023_Hawaii_wildfires#L%C4%81hain%C4%81>`_. Data is sourced from a "
"Cloud-Optimized GeoTIFF (COG) file hosted on `OpenAerialMap <https://map."
"openaerialmap.org>`_ under a `CC BY-NC 4.0 <https://creativecommons.org/"
"licenses/by-nc/4.0/>`_ license."
msgstr ""

#: ../../../gallery/images/rgb_image.rst:38
msgid ""
"import pygmt\n"
"import rioxarray\n"
"from pygmt.params import Axis, Frame"
msgstr ""

#: ../../../gallery/images/rgb_image.rst:47
msgid "Read 3-band data from GeoTIFF into an xarray.DataArray object:"
msgstr ""

#: ../../../gallery/images/rgb_image.rst:51
msgid ""
"with rioxarray.open_rasterio(\n"
"    filename=\"https://oin-hotosm-temp.s3.us-east-1.amazonaws."
"com/64d6a49a19cb3a000147a65b/0/64d6a49a19cb3a000147a65c.tif\",\n"
"    overview_level=5,\n"
") as img:\n"
"    # Subset to area of Lāhainā in EPSG:32604 coordinates\n"
"    image = img.rio.clip_box(minx=738000, maxx=755000, miny=2300000, "
"maxy=2318000)\n"
"    image = image.load()  # Force loading the DataArray into memory\n"
"image"
msgstr ""

#: ../../../gallery/images/rgb_image.rst:65
msgid "Plot the RGB imagery:"
msgstr ""

#: ../../../gallery/images/rgb_image.rst:69
msgid ""
"fig = pygmt.Figure()\n"
"with pygmt.config(FONT_TITLE=\"Times-Roman\"):  # Set title font to Times-"
"Roman\n"
"    fig.grdimage(\n"
"        grid=image,\n"
"        # Use a map scale where 1 cm on the map equals 1 km on the ground\n"
"        projection=\"x1:100000\",\n"
"        frame=Frame(\n"
"            axes=\"WSne\",\n"
"            title=r\"L@!a¯hain@!a¯, Hawai`i on 9 Aug 2023\",\n"
"            axis=Axis(annot=True, tick=True),\n"
"        ),\n"
"    )\n"
"fig.show()"
msgstr ""

