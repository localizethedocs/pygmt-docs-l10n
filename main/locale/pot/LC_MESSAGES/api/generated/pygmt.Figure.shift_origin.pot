#: ../../../api/generated/pygmt.Figure.shift_origin.rst:2
msgid "pygmt.Figure.shift\\_origin"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/shift_origin.py:docstring
#: of pygmt.src.shift_origin.shift_origin:1
msgid "Shift the plot origin in x- and/or y-directions."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/shift_origin.py:docstring
#: of pygmt.src.shift_origin.shift_origin:3
msgid ""
"The shifts can be permanent or temporary. If used as a standalone method, "
"the shifts are permanent and apply to all subsequent plots. If used as a "
"context manager, the shifts are temporary and only apply to the block of "
"code within the context manager."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/shift_origin.py:docstring
#: of pygmt.src.shift_origin.shift_origin:7
msgid "Use as a standalone method to shift the plot origin permanently:"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/shift_origin.py:docstring
#: of pygmt.src.shift_origin.shift_origin:9
msgid ""
"fig.shift_origin(...)\n"
"...  # Other plot commands"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/shift_origin.py:docstring
#: of pygmt.src.shift_origin.shift_origin:14
msgid "Use as a context manager to shift the plot origin temporarily:"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/shift_origin.py:docstring
#: of pygmt.src.shift_origin.shift_origin:16
msgid ""
"with fig.shift_origin(...):\n"
"    ...  # Other plot commands\n"
"    ..."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/shift_origin.py:docstring
#: of pygmt.src.shift_origin.shift_origin:22
msgid ""
"The shifts *xshift* and *yshift* in x- and y-directions are relative to the "
"current plot origin. The default unit for shifts is centimeters (**c**) but "
"can be changed to other units via :gmt-term:`PROJ_LENGTH_UNIT`. Optionally, "
"append the length unit (see :ref:`dimension-units`) to the shifts."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/shift_origin.py:docstring
#: of pygmt.src.shift_origin.shift_origin:27
msgid ""
"For *xshift*, character **w** can be used, which represents the bounding box "
"**width** of the last plotting object. The full syntax is [[±][*f*]\\ "
"**w**\\ [/*d*]±]\\ *xoff*, where optional signs, factor *f* and divisor *d* "
"can be used to compute an offset that may be adjusted further by ±\\ *xoff*. "
"Assuming that the last plotting object has a width of 10 centimeters, here "
"are some example values for *xshift*:"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/shift_origin.py:docstring
#: of pygmt.src.shift_origin.shift_origin:34
msgid "``\"w\"``: x-shift is 10 cm"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/shift_origin.py:docstring
#: of pygmt.src.shift_origin.shift_origin:35
msgid "``\"w+2c\"``: x-shift is 10+2=12 cm"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/shift_origin.py:docstring
#: of pygmt.src.shift_origin.shift_origin:36
msgid "``\"2w+3c\"``: x-shift is 2*10+3=23 cm"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/shift_origin.py:docstring
#: of pygmt.src.shift_origin.shift_origin:37
msgid "``\"w/2-2c\"``: x-shift is 10/2-2=3 cm"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/shift_origin.py:docstring
#: of pygmt.src.shift_origin.shift_origin:39
msgid ""
"Similarly, for *yshift*, character **h** can be used, which is the bounding "
"box **height** of the last plotting object."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/shift_origin.py:docstring
#: of pygmt.src.shift_origin.shift_origin:42
msgid ""
"**Note**: The last plotting object can be a basemap, image, logo, legend, "
"colorbar, etc."
msgstr ""

