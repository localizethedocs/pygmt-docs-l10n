#: of pygmt.src.dimfilter.dimfilter:70
msgid "**c**: cosine arch. Weights follow a cosine arch curve."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/dimfilter.py:docstring
#: of pygmt.src.dimfilter.dimfilter:71
msgid "**g**: Gaussian. Weights are given by the Gaussian function."
