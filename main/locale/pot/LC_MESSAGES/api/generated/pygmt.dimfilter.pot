#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/dimfilter.py:docstring
#: of pygmt.src.dimfilter.dimfilter:49
msgid ""
"Distance flag tells how grid (x,y) relates to filter width, as follows:  - "
"**0**: grid (x,y) in same units as *width*, Cartesian distances. - **1**: "
"grid (x,y) in degrees, *width* in kilometers, Cartesian distances. - **2**: "
"grid (x,y) in degrees, *width* in km, dx scaled by cos(middle y),   "
"Cartesian distances.  The above options are fastest because they allow "
"weight matrix to be computed only once. The next two options are slower "
"because they recompute weights for each latitude.  - **3**: grid (x,y) in "
"degrees, *width* in km, dx scaled by cosine(y),   Cartesian distance "
"calculation. - **4**: grid (x,y) in degrees, *width* in km, Spherical "
"distance calculation."
msgstr ""

