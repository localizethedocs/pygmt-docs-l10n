#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/datasets/earth_age.py:docstring
#: of pygmt.datasets.earth_age.load_earth_age:45
msgid ""
"*grid* -- The Earth seafloor crustal age grid. Coordinates are latitude and "
"longitude in degrees. Age is in millions of years (Myr)."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/datasets/earth_age.py:docstring
#: of pygmt.datasets.earth_age.load_earth_age:50
