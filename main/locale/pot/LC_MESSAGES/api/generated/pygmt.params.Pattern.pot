#: ../../../api/generated/pygmt.params.Pattern.rst:2
msgid "pygmt.params.Pattern"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/pattern.py:docstring
#: of pygmt.params.pattern.Pattern:1
msgid "Class for specifying bit and hachure patterns."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/pattern.py:docstring
#: of pygmt.params.pattern.Pattern:3
msgid ""
"This class allows users to specify predefined bit-patterns or custom 1-, 8-, "
"or 24-bit image raster files to fill symbols and polygons in various PyGMT "
"plotting methods. The patterns can be customized with different resolution "
"and different foreground and background colors. The foreground and "
"background colors can also be inverted."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/pattern.py:docstring
#: of pygmt.params.pattern.Pattern:9
msgid ""
"GMT provides 90 predefined patterns that can be used in PyGMT. The patterns "
"are numbered from 1 to 90, and shown below:"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/pattern.py:docstring
#: of pygmt.params.pattern.Pattern:12
msgid "The 90 predefined bit-patterns provided with GMT"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/pattern.py:docstring
#: of pygmt.params.pattern.Pattern:18
msgid "Examples"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/pattern.py:docstring
#: of pygmt.params.pattern.Pattern:19
msgid ""
"Draw a global map with land areas filled with pattern 15 in a light red "
"background and 200 dpi resolution:"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/pattern.py:docstring
#: of pygmt.params.Pattern.pattern:1
msgid "The pattern to use. It can be specified in two forms:"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/pattern.py:docstring
#: of pygmt.params.Pattern.pattern:3
msgid ""
"An integer in the range of 1-90, corresponding to one of 90 predefined 64x64 "
"bit-patterns. [Default is 1]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/pattern.py:docstring
#: of pygmt.params.Pattern.pattern:5
msgid ""
"Name of a 1-, 8-, or 24-bit image raster file, to create customized, "
"repeating images using image raster files."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/pattern.py:docstring
#: of pygmt.params.Pattern.dpi:1
msgid "Resolution of the pattern in dots per inch (DPI) [Default is 300]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/pattern.py:docstring
#: of pygmt.params.Pattern.bgcolor:1
msgid ""
"The background color for predefined bit-patterns or 1-bit images. Setting "
"either ``bgcolor`` or ``fgcolor`` to an empty string will yield a "
"transparent background/foreground where only the foreground/background "
"pixels will be painted. [Default is white for background and black for "
"foreground]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/pattern.py:docstring
#: of pygmt.params.Pattern.fgcolor:1
msgid "The foreground color for predefined bit-patterns or 1-bit images."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/pattern.py:docstring
#: of pygmt.params.Pattern.invert:1
msgid ""
"If ``True``, the pattern will be bit-inverted, i.e., white and black areas "
"will be interchanged (only applies to predefined bit-patterns or 1-bit "
"images)."
msgstr ""

