#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/x2sys_init.py:docstring
#: of pygmt.src.x2sys_init.x2sys_init:86
msgid ""
"**t**\\|\\ **d**\\ *gap*. Give **t** or **d** and append the corresponding "
"maximum time gap (in user units; this is typically seconds [Default is "
"infinity]), or distance (for units, see ``units``) gap [Default is "
"infinity]) allowed between the two data points immediately on either side of "
"a crossover. If these limits are exceeded then a data gap is assumed and no "
"COE will be determined."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/x2sys_init.py:docstring
