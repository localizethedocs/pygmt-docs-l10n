#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/info.py:docstring
#: of pygmt.src.info.info:33
msgid ""
"Pass in either a file name to an ASCII data table, a 1-D/2-D :class:`numpy."
"ndarray`, a :class:`pandas.DataFrame`, an :class:`xarray.Dataset` made up of "
"1-D :class:`xarray.DataArray` data variables, or a :class:`geopandas."
"GeoDataFrame` containing the tabular data."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/info.py:docstring
#: of pygmt.src.info.info:39
msgid ""
"Report the min/max values per column in separate columns [Default is the "
"format <min/max>]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/info.py:docstring
#: of pygmt.src.info.info:42
msgid ""
"[**b**\\|\\ **p**\\|\\ **f**\\|\\ **s**]\\ *dx*\\[/*dy*\\[/*dz*...]]. "
"Compute the min/max values of the first n columns to the nearest multiple of "
"the provided increments [default is 2 columns]. By default, output results "
"in the form ``[w, e, s, n]``, unless ``per_column`` is set in which case we "
"output each min and max value in separate output columns."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/info.py:docstring
#: of pygmt.src.info.info:48
msgid ""
"**dz**\\[\\ **+c**\\ *col*]. Report the min/max of the first (0'th) column "
"to the nearest multiple of dz and output this in the form ``[zmin, zmax, "
"dz]``."
msgstr ""

