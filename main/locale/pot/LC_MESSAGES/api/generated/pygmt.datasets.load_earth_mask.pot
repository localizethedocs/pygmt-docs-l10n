#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/datasets/earth_mask.py:docstring
#: of pygmt.datasets.earth_mask.load_earth_mask:38
msgid ""
"*grid* -- The Earth mask grid. Coordinates are latitude and longitude in "
"degrees. The node values in the mask grids are all in the 0-4 range and "
"reflect different surface types:  - 0: Oceanic areas beyond the shoreline - "
"1: Land areas inside the shoreline - 2: Lakes inside the land areas - 3: "
"Islands in lakes in the land areas - 4: Smaller lakes in islands that are "
"found within lakes   inside the land area"
msgstr ""

