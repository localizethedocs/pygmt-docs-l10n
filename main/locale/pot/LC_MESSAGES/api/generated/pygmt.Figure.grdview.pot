#: of pygmt.src.grdview.grdview:55
msgid "``\"mesh\"``: mesh plot [Default]."
msgstr ""

#: ../../../../../../.conda/lib/python3.15/site-packages/pygmt/src/grdview.py:docstring
#: of pygmt.src.grdview.grdview:56
msgid "``\"surface\"``: surface plot."
