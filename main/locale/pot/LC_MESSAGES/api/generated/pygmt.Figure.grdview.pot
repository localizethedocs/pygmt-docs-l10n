#: ../../../../../../.conda/lib/python3.15/site-packages/pygmt/src/grdview.py:docstring
#: of pygmt.src.grdview.grdview:3
msgid ""
"Reads a 2-D grid file and produces a 3-D perspective plot by drawing a mesh, "
"painting a colored/gray-shaded surface made up of polygons, or by scanline "
"conversion of these polygons to a raster image. Options include draping a "
"data set on top of a surface, plotting of contours on top of the surface, "
"and apply artificial illumination based on intensities provided in a "
"separate grid file."
msgstr ""

