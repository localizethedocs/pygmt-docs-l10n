#: of pygmt.src.grdview.grdview:67
msgid ""
"Force conversion to monochrome image using the (television) YIQ "
"transformation."
msgstr ""

#: ../../../../../../.conda/lib/python3.15/site-packages/pygmt/src/grdview.py:docstring
#: of pygmt.src.grdview.grdview:69
msgid ""
