#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/choropleth.py:docstring
#: of pygmt.src.choropleth.choropleth:3
msgid ""
"This method creates a choropleth map by filling each polygon according to an "
"attribute value. It requires the input data to be a geo-like Python object "
"that implements ``__geo_interface__`` and includes the values used to fill "
"the polygons as an attribute field (e.g. a :class:`geopandas.GeoDataFrame`), "
"or an OGR_GMT file containing the geometry and data to plot."
msgstr ""

