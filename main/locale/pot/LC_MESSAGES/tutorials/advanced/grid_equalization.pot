#: ../../../tutorials/advanced/grid_equalization.rst:22
msgid "Performing grid histogram equalization"
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:24
msgid ""
"The :meth:`pygmt.grdhisteq.equalize_grid` method creates a grid using "
"statistics based on a cumulative distribution function."
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:29
msgid ""
"import pygmt\n"
"from pygmt.params import Axis, Frame, Position"
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:38
msgid "Load sample data"
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:40
msgid ""
"Load the sample Earth relief data for a region around Yosemite Valley and "
"use :func:`pygmt.grd2xyz` to create a :class:`pandas.Series` with the z-"
"values."
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:46
msgid ""
"grid = pygmt.datasets.load_earth_relief(\n"
"    resolution=\"03s\", region=[-119.825, -119.4, 37.6, 37.825]\n"
")\n"
"grid_dist = pygmt.grd2xyz(grid=grid, output_type=\"pandas\")[\"z\"]"
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:59
msgid "Plot the original digital elevation model and data distribution"
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:61
msgid ""
"For comparison, we will create a map of the original digital elevation model "
"and a histogram showing the distribution of elevation data values."
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:66
msgid ""
"# Create an instance of the Figure class\n"
"fig = pygmt.Figure()\n"
"# Define figure configuration\n"
"pygmt.config(FORMAT_GEO_MAP=\"ddd.x\", MAP_FRAME_TYPE=\"plain\")\n"
"# Define the colormap for the figure\n"
"pygmt.makecpt(series=[500, 3540], cmap=\"SCM/turku\")\n"
"# Setup subplots with two panels\n"
"with fig.subplot(\n"
"    nrows=1, ncols=2, figsize=(\"13.5c\", \"4c\"), title=\"Digital Elevation "
"Model\"\n"
"):\n"
"    # Plot the original digital elevation model in the first panel\n"
"    with fig.set_panel(panel=0):\n"
"        fig.grdimage(grid=grid, projection=\"M?\", "
"frame=Frame(axes=\"WSne\"), cmap=True)\n"
"    # Plot a histogram showing the z-value distribution in the original "
"digital\n"
"    # elevation model\n"
"    with fig.set_panel(panel=1):\n"
"        fig.histogram(\n"
"            data=grid_dist,\n"
"            projection=\"X?\",\n"
"            region=[500, 3600, 0, 20],\n"
"            series=[500, 3600, 100],\n"
"            frame=Frame(\n"
"                axes=\"wnSE\",\n"
"                xaxis=Axis(annot=True, tick=True, label=\"Elevation (m)\"),\n"
"                yaxis=Axis(annot=True, tick=True, label=\"Percent "
"frequency\"),\n"
"            ),\n"
"            cmap=True,\n"
"            histtype=1,\n"
"            pen=\"1p,black\",\n"
"        )\n"
"        fig.colorbar(\n"
"            position=Position(\"MR\", cstype=\"outside\", offset=(1.5, 0)),\n"
"            length=3,\n"
"            width=0.3,\n"
"            frame=True,\n"
"        )\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:112
msgid "Equalize grid based on a linear distribution"
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:114
msgid ""
"The :meth:`pygmt.grdhisteq.equalize_grid` method creates a new grid with the "
"z-values representing the position of the original z-values in a given "
"cumulative distribution. By default, it computes the position in a linear "
"distribution. Here, we equalize the grid into nine divisions based on a "
"linear distribution and produce a :class:`pandas.Series` with the z-values "
"for the new grid."
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:123
msgid ""
"divisions = 9\n"
"linear = pygmt.grdhisteq.equalize_grid(grid=grid, divisions=divisions)\n"
"linear_dist = pygmt.grd2xyz(grid=linear, output_type=\"pandas\")[\"z\"]"
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:135
#: ../../../tutorials/advanced/grid_equalization.rst:306
msgid "Calculate the bins used for data transformation"
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:137
msgid ""
"The :meth:`pygmt.grdhisteq.compute_bins` method reports statistics about the "
"grid equalization. Here, we report the bins that would linearly divide the "
"original data into 9 divisions with equal area. In our new grid produced by :"
"meth:`pygmt.grdhisteq.equalize_grid`, all the grid cells with values between "
"``start`` and ``stop`` of ``bin_id=0`` are assigned the value 0, all grid "
"cells with values between ``start`` and ``stop`` of ``bin_id=1`` are "
"assigned the value 1, and so on."
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:147
msgid "pygmt.grdhisteq.compute_bins(grid=grid, divisions=divisions)"
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:157
msgid "Plot the equally distributed data"
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:159
msgid ""
"Here we create a map showing the grid that has been transformed to have a "
"linear distribution with nine divisions and a histogram of the data values."
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:165
msgid ""
"# Create an instance of the Figure class\n"
"fig = pygmt.Figure()\n"
"# Define figure configuration\n"
"pygmt.config(FORMAT_GEO_MAP=\"ddd.x\", MAP_FRAME_TYPE=\"plain\")\n"
"# Define the colormap for the figure\n"
"pygmt.makecpt(series=[0, divisions, 1], cmap=\"SCM/lajolla\")\n"
"# Setup subplots with two panels\n"
"with fig.subplot(\n"
"    nrows=1, ncols=2, figsize=(\"13.5c\", \"4c\"), title=\"Linear "
"distribution\"\n"
"):\n"
"    # Plot the grid with a linear distribution in the first panel\n"
"    with fig.set_panel(panel=0):\n"
"        fig.grdimage(grid=linear, projection=\"M?\", "
"frame=Frame(axes=\"WSne\"), cmap=True)\n"
"    # Plot a histogram showing the linear z-value distribution\n"
"    with fig.set_panel(panel=1):\n"
"        fig.histogram(\n"
"            data=linear_dist,\n"
"            projection=\"X?\",\n"
"            region=[-1, divisions, 0, 40],\n"
"            series=[0, divisions, 1],\n"
"            frame=Frame(\n"
"                axes=\"wnSE\",\n"
"                xaxis=Axis(annot=True, tick=True, label=\"Relative "
"elevation\"),\n"
"                yaxis=Axis(annot=True, tick=True, label=\"Percent "
"frequency\"),\n"
"            ),\n"
"            cmap=True,\n"
"            histtype=1,\n"
"            pen=\"1p,black\",\n"
"            center=True,\n"
"        )\n"
"        fig.colorbar(\n"
"            position=Position(\"MR\", cstype=\"outside\", offset=(1.5, 0)),\n"
"            length=3,\n"
"            width=0.3,\n"
"            frame=True,\n"
"        )\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:211
msgid "Transform grid based on a normal distribution"
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:213
msgid ""
"The ``gaussian`` parameter of :meth:`pygmt.grdhisteq.equalize_grid` can be "
"used to transform the z-values relative to their position in a normal "
"distribution rather than a linear distribution. In this case, the output "
"data are continuous rather than discrete."
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:220
msgid ""
"normal = pygmt.grdhisteq.equalize_grid(grid=grid, gaussian=True)\n"
"normal_dist = pygmt.grd2xyz(grid=normal, output_type=\"pandas\")[\"z\"]"
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:231
msgid "Plot the normally distributed data"
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:233
msgid ""
"Here we create a map showing the grid that has been transformed to have a "
"normal distribution and a histogram of the data values."
msgstr ""

#: ../../../tutorials/advanced/grid_equalization.rst:238
msgid ""
"# Create an instance of the Figure class\n"
"fig = pygmt.Figure()\n"
"# Define figure configuration\n"
"pygmt.config(FORMAT_GEO_MAP=\"ddd.x\", MAP_FRAME_TYPE=\"plain\")\n"
"# Define the colormap for the figure\n"
"pygmt.makecpt(series=[-4.5, 4.5], cmap=\"SCM/vik\")\n"
"# Setup subplots with two panels\n"
"with fig.subplot(\n"
"    nrows=1, ncols=2, figsize=(\"13.5c\", \"4c\"), title=\"Normal "
"distribution\"\n"
"):\n"
"    # Plot the grid with a normal distribution in the first panel\n"
"    with fig.set_panel(panel=0):\n"
"        fig.grdimage(grid=normal, projection=\"M?\", "
"frame=Frame(axes=\"WSne\"), cmap=True)\n"
