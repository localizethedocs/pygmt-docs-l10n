#: ../../../tutorials/advanced/cartesian_histograms.rst:39
msgid "Import the required packages"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:43
msgid ""
"import numpy as np\n"
"import pygmt\n"
"from pygmt.params import Axis, Frame, Pattern"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:52
msgid "Generate random data from a normal distribution:"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:56
msgid ""
"rng = np.random.default_rng(seed=100)\n"
"\n"
"# Mean of distribution\n"
"mean = 100\n"
"# Standard deviation of distribution\n"
"stddev = 20\n"
"\n"
"# Create two data sets\n"
"data01 = rng.normal(loc=mean, scale=stddev, size=42)\n"
"data02 = rng.normal(loc=mean, scale=stddev * 2, size=42)"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:75
msgid "Choosing the bins"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:77
msgid ""
"The ``series`` parameter controls how the data are grouped into bins. "
"Changing the bin width can reveal or hide features in the same data set, so "
"choosing the bins is an important first step when creating a histogram."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:81
msgid ""
"A single number sets the bin width. The binning range is determined from the "
"data or from ``region``. For example, ``series=10`` gives bins that are 10 "
"units wide. Use ``region`` to set the displayed range as [*xmin*, *xmax*, "
"*ymin*, *ymax*]. Setting both y-limits to the same value lets GMT determine "
"them automatically."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:89
msgid ""
"fig = pygmt.Figure()\n"
"\n"
"fig.histogram(\n"
"    data=data01,\n"
"    series=10,\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X6c\",\n"
"    frame=Frame(\n"
"        axes=\"WSne\",\n"
"        title=\"Bin width: 10\",\n"
"        xaxis=Axis(annot=50, tick=10),\n"
"        yaxis=Axis(annot=True, label=\"Counts\"),\n"
"    ),\n"
"    fill=\"red3\",\n"
"    pen=\"1p,darkgray\",\n"
")"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:112
msgid ""
"A list or tuple of three numbers specifies the minimum, maximum, and "
"increment of the binning. Here, ``series=[0, 200, 20]`` uses bins from 0 to "
"200 with a width of 20. This is equivalent to the GMT-style string "
"``series=\"0/200/20\"``. ``region`` controls the plot limits, while "
"``series`` controls the bin boundaries."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:119
msgid ""
"fig.shift_origin(xshift=\"w+1.5c\")\n"
"\n"
"fig.histogram(\n"
"    data=data01,\n"
"    series=[0, 200, 20],\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X6c\",\n"
"    frame=Frame(\n"
"        axes=\"WSne\",\n"
"        title=\"Bin width: 20\",\n"
"        xaxis=Axis(annot=50, tick=10),\n"
"        yaxis=Axis(annot=True, label=\"Counts\"),\n"
"    ),\n"
"    fill=\"red3\",\n"
"    pen=\"1p,darkgray\",\n"
")"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:142
msgid ""
"To set the bin boundaries explicitly, pass a sequence of boundary values. "
"These bins can have different widths. Here, the boundaries are closer "
"together near the center of the distribution. The bar heights still show "
"counts, so a wider bin can contain more observations even where the data are "
"less concentrated."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:147
msgid ""
"A list or tuple with exactly three elements is always interpreted as "
"[*minimum*, *maximum*, *increment*], rather than three boundaries. To give "
"exactly three boundaries, use a NumPy array, e.g., ``series=np.array([0, "
"100, 200])``."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:153
msgid ""
"fig.shift_origin(xshift=\"w+1.5c\")\n"
"\n"
"fig.histogram(\n"
"    data=data01,\n"
"    series=np.array([0, 60, 80, 90, 100, 110, 120, 140, 200]),\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X6c\",\n"
"    frame=Frame(\n"
"        axes=\"WSne\",\n"
"        title=\"Explicit boundaries\",\n"
"        xaxis=Axis(annot=50, tick=10),\n"
"        yaxis=Axis(annot=True, label=\"Counts\"),\n"
"    ),\n"
"    fill=\"red3\",\n"
"    pen=\"1p,darkgray\",\n"
")\n"
"\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:180
msgid "Histogram styles"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:182
msgid ""
"Combine ``fill``, ``pen``, and ``stairs`` to change the appearance of a "
"histogram without changing its bins or counts. ``fill`` sets the color or "
"pattern inside the bars, and ``pen`` sets the width, color, and style of "
"their outlines. With ``stairs=True``, only the outer outline is drawn, "
"without internal bars. The four plots below use the same data, bins, and "
"axis limits for comparison."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:190
msgid ""
"fig = pygmt.Figure()\n"
"\n"
"# Filled bars\n"
"fig.histogram(\n"
"    data=data01,\n"
"    series=10,\n"
"    region=[0, 200, 0, 12],\n"
"    projection=\"X5c\",\n"
"    frame=Frame(\n"
"        axes=\"WSne\",\n"
"        title=\"Filled bars\",\n"
"        xaxis=Axis(annot=50, tick=10),\n"
"        yaxis=Axis(annot=2, label=\"Counts\"),\n"
"    ),\n"
"    fill=\"red3\",\n"
")\n"
"\n"
"fig.shift_origin(xshift=\"w+1.5c\")\n"
"\n"
"# Outlined bars\n"
"fig.histogram(\n"
"    data=data01,\n"
"    series=10,\n"
"    region=[0, 200, 0, 12],\n"
"    projection=\"X5c\",\n"
"    frame=Frame(\n"
"        axes=\"WSne\",\n"
"        title=\"Outlined bars\",\n"
"        xaxis=Axis(annot=50, tick=10),\n"
"        yaxis=Axis(annot=2, label=\"Counts\"),\n"
"    ),\n"
"    pen=\"1p,red3\",\n"
")\n"
"\n"
"fig.shift_origin(xshift=\"w+1.5c\")\n"
"\n"
"# Stair-step outline\n"
"fig.histogram(\n"
"    data=data01,\n"
"    series=10,\n"
"    region=[0, 200, 0, 12],\n"
"    projection=\"X5c\",\n"
"    frame=Frame(\n"
"        axes=\"WSne\",\n"
"        title=\"Stair-step outline\",\n"
"        xaxis=Axis(annot=50, tick=10),\n"
"        yaxis=Axis(annot=2, label=\"Counts\"),\n"
"    ),\n"
"    pen=\"1p,red3\",\n"
"    stairs=True,\n"
")\n"
"\n"
"fig.shift_origin(xshift=\"w+1.5c\")\n"
"\n"
"# Filled stair-steps\n"
"fig.histogram(\n"
"    data=data01,\n"
"    series=10,\n"
"    region=[0, 200, 0, 12],\n"
"    projection=\"X5c\",\n"
"    frame=Frame(\n"
"        axes=\"WSne\",\n"
"        title=\"Filled stair-steps\",\n"
"        xaxis=Axis(annot=50, tick=10),\n"
"        yaxis=Axis(annot=2, label=\"Counts\"),\n"
"    ),\n"
"    fill=\"red3\",\n"
"    pen=\"1p,darkgray\",\n"
"    stairs=True,\n"
")\n"
"\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:271
msgid "Counts and frequency percent"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:273
msgid ""
"By default, a histogram showing the counts in each bin is created "
"(``histtype=\"count\"``). To show the percentage of values in each bin, set "
"the ``histtype`` parameter to ``\"percent\"``. For further options please "
"have a look at the documentation of :meth:`pygmt.Figure.histogram`."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:280
msgid ""
"fig = pygmt.Figure()\n"
"\n"
"# Create histogram for data02 showing counts\n"
"fig.histogram(\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X10c\",\n"
"    frame=Frame(\n"
"        axes=\"WSnr\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=1, tick=1, label=\"Counts\"),\n"
"    ),\n"
"    data=data02,\n"
"    series=10,\n"
"    fill=\"orange\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    # Choose counts via the \"histtype\" parameter\n"
"    histtype=\"count\",\n"
")\n"
"\n"
"fig.shift_origin(xshift=\"w+1c\")\n"
"\n"
"# Create histogram for data02 showing frequency percent\n"
"fig.histogram(\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X10c\",\n"
"    # Add suffix % (+u)\n"
"    frame=Frame(\n"
"        axes=\"lSnE\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=2, tick=1, unit=\"%\", label=\"Frequency "
"percent\"),\n"
"    ),\n"
"    data=data02,\n"
"    series=10,\n"
"    fill=\"orange\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    # Choose percentages via the \"histtype\" parameter\n"
"    histtype=\"percent\",\n"
")\n"
"\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:329
msgid "Cumulative values"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:331
msgid ""
"To create a histogram showing the cumulative values set ``cumulative=True``. "
"Here, the bars of the cumulative histogram are filled with "
"a :class:`pygmt.params.Pattern` via the ``fill`` parameter. Annotate each "
"bar with the counts it represents using the ``annot`` parameter."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:338
msgid ""
"fig = pygmt.Figure()\n"
"\n"
"# Create histogram for data01 showing the counts per bin\n"
"fig.histogram(\n"
"    region=[0, 200, 0, len(data01) + 1],\n"
"    projection=\"X10c\",\n"
"    frame=Frame(\n"
"        axes=\"WSne\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=5, tick=1, label=\"Counts\"),\n"
"    ),\n"
"    data=data01,\n"
"    series=10,\n"
"    fill=\"red3\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    histtype=\"count\",\n"
"    annot=True,\n"
")\n"
"\n"
"fig.shift_origin(xshift=\"w+1c\")\n"
"\n"
"# Create histogram for data01 showing the cumulative counts\n"
"fig.histogram(\n"
"    region=[0, 200, 0, len(data01) + 1],\n"
"    projection=\"X10c\",\n"
"    frame=Frame(\n"
"        axes=\"wSnE\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=5, tick=1, label=\"Cumulative counts\"),\n"
"    ),\n"
"    data=data01,\n"
"    series=10,\n"
"    # Fill bars with GMT pattern 8, with white background and black "
"foreground.\n"
"    fill=Pattern(8, bgcolor=\"white\", fgcolor=\"black\"),\n"
"    pen=\"1p,darkgray,solid\",\n"
"    histtype=\"count\",\n"
"    cumulative=True,  # Show cumulative counts\n"
"    annot=True,\n"
"    annot_offset=\"-10p\",  # Offset the annotations by 10 points in "
"negative y-direction\n"
")\n"
"\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:389
msgid "Distribution curves"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:391
msgid ""
"Use ``distribution`` to add an equivalent normal distribution curve "
"calculated from the data. Set it to ``\"mean\"`` to use the mean and "
"standard deviation, or ``\"median\"`` to use the median and a scale based on "
"the median absolute deviation. A third option, ``\"lms\"``, uses the least "
"median of squares mode and scale. These curves summarize the data; they do "
"not imply that the data are normally distributed."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:398
msgid ""
"Pass a list to compare several curves. ``distribution_pen`` controls their "
"appearance: a single pen applies to every curve, while a list of pens "
"matches the order of the modes in ``distribution``. Below, the mean-based "
"curve is solid red, and the median-based curve is dashed blue. GMT scales "
"the curves to the histogram, so no separate probability density calculation "
"is needed."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:406
msgid ""
"fig = pygmt.Figure()\n"
"\n"
"fig.histogram(\n"
"    data=data01,\n"
"    series=10,\n"
"    region=[0, 200, 0, 12],\n"
"    projection=\"X10c\",\n"
"    frame=Frame(\n"
"        axes=\"WSne\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=1, label=\"Counts\"),\n"
"    ),\n"
"    fill=\"lightgray\",\n"
"    pen=\"1p,darkgray\",\n"
"    distribution=[\"mean\", \"median\"],\n"
"    distribution_pen=[\"1.5p,red3\", \"1.5p,blue,dashed\"],\n"
")\n"
"\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:434
msgid "Overlaid bars"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:436
msgid ""
"Overlaid or overlapping bars can be achieved by plotting two or several "
"histograms, each for one data set, on top of each other. The legend entry "
"can be specified via the ``label`` parameter."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:440
msgid "Limitations of histograms with overlaid bars are:"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:442
msgid "Mixing of colors or/and patterns"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:443
msgid "Visually more colors or/and patterns than data sets"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:444
msgid ""
"Visually a \"third histogram\" (or more in case of more than two data sets)"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:448
msgid ""
"fig = pygmt.Figure()\n"
"\n"
"# Create histogram for data01\n"
"fig.histogram(\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X10c\",\n"
"    frame=Frame(\n"
"        axes=\"WSne\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=1, tick=1, label=\"Counts\"),\n"
"    ),\n"
"    data=data01,\n"
"    series=10,\n"
"    fill=\"red3\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    histtype=\"count\",\n"
"    # Set legend entry\n"
"    label=\"data01\",\n"
")\n"
"\n"
"# Create histogram for data02\n"
"# It is plotted on top of the histogram for data01\n"
"fig.histogram(\n"
"    data=data02,\n"
"    series=10,\n"
"    # Fill bars with color \"orange\", use a transparency of 50% (\"@50\")\n"
"    fill=\"orange@50\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    histtype=\"count\",\n"
"    label=\"data02\",\n"
")\n"
"\n"
"# Add legend\n"
"fig.legend()\n"
"\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:493
msgid "Stacked bars"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:495
msgid ""
"Histograms with stacked bars are not directly supported by PyGMT. Thus, "
"before plotting, combined data sets have to be created from the single data "
"sets. Then, stacked bars can be achieved similar to overlaid bars via "
"plotting two or several histograms on top of each other."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:500
msgid "Limitations of histograms with stacked bars are:"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:502
msgid "No common baseline"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:503
msgid "Partly not directly clear whether overlaid or stacked bars"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:507
msgid ""
"# Combine the two data sets to one data set\n"
"data_merge = np.concatenate((data01, data02), axis=None)\n"
"\n"
"fig = pygmt.Figure()\n"
"\n"
"# Create histogram for data02 by using the combined data set\n"
"fig.histogram(\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X10c\",\n"
"    frame=Frame(\n"
"        axes=\"WSne\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=1, tick=1, label=\"Counts\"),\n"
"    ),\n"
"    data=data_merge,\n"
"    series=10,\n"
"    fill=\"orange\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    histtype=\"count\",\n"
"    # The combined data set appears in the final histogram visually as data "
"set data02\n"
"    label=\"data02\",\n"
")\n"
"\n"
"# Create histogram for data01\n"
"# It is plotted on top of the histogram for data02\n"
"fig.histogram(\n"
"    data=data01,\n"
"    series=10,\n"
"    fill=\"red3\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    histtype=\"count\",\n"
"    label=\"data01\",\n"
")\n"
"\n"
"# Add legend\n"
"fig.legend()\n"
"\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:554
msgid "Grouped bars"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:556
msgid ""
"By setting the ``bar_width`` parameter in respect to the values passed to "
"the ``series`` parameter histograms with grouped bars can be created."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:559
msgid "Limitations of histograms with grouped bars are:"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:561
msgid ""
"Careful setting width and position of the bars in respect to the bin width"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:562
msgid "Difficult to see the variations of the single data sets"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:566
msgid ""
"# Width used for binning the data\n"
"binwidth = 10\n"
"\n"
"fig = pygmt.Figure()\n"
"\n"
"# Create histogram for data01\n"
"fig.histogram(\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X10c\",\n"
"    frame=Frame(\n"
"        axes=\"WSne\",\n"
"        xaxis=Axis(annot=True, tick=10, grid=10),\n"
"        yaxis=Axis(annot=1, tick=1, label=\"Counts\"),\n"
"    ),\n"
"    data=data01,\n"
"    series=binwidth,\n"
"    fill=\"red3\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    histtype=\"count\",\n"
"    # Calculate the bar width in respect to the bin width, here for two data "
"sets half\n"
"    # of the bin width\n"
"    bar_width=binwidth / 2,\n"
"    # Offset the bars to align each bar with the left limit of the "
"corresponding bin\n"
"    bar_offset=-binwidth / 4,\n"
"    label=\"data01\",\n"
")\n"
"\n"
"# Create histogram for data02\n"
"fig.histogram(\n"
"    data=data02,\n"
"    series=binwidth,\n"
"    fill=\"orange\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    histtype=\"count\",\n"
"    bar_width=binwidth / 2,\n"
"    bar_offset=binwidth / 4,\n"
"    label=\"data02\",\n"
")\n"
"\n"
"# Add legend\n"
"fig.legend()\n"
"\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:617
msgid "Vertical and horizontal bars"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:619
msgid ""
"To define the width of the bins, the ``series`` parameter has to be "
"specified. The bars can be filled via the ``fill`` parameter with either a "
"color or a pattern. Use the ``pen`` parameter to adjust width, color, and "
"style of the outlines. By default, a histogram with vertical bars is "
"created. Horizontal bars can be achieved via ``horizontal=True``."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:627
msgid ""
"fig = pygmt.Figure()\n"
"\n"
"# Create histogram for data01 with vertical bars\n"
"fig.histogram(\n"
"    # Define the plot range as a list of xmin, xmax, ymin, ymax\n"
"    # Let ymin and ymax determined automatically by setting both to the same "
"value\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X10c\",  # Cartesian projection with a width of 10 "
"centimeters\n"
"    # Add frame, annotations (\"a\"), ticks (\"f\"), and y-axis label "
"(\"+l\") \"Counts\"; the\n"
"    # numbers give the steps of annotations and ticks\n"
"    frame=Frame(\n"
"        axes=\"WStr\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=1, tick=1, label=\"Counts\"),\n"
"    ),\n"
"    data=data01,\n"
"    # Set the bin width via the \"series\" parameter\n"
"    series=10,\n"
"    # Fill the bars with color \"red3\"\n"
"    fill=\"red3\",\n"
"    # Draw a 1-point thick, solid outline in \"darkgray\" around the bars\n"
"    pen=\"1p,darkgray,solid\",\n"
"    # Choose counts via the \"histtype\" parameter\n"
"    histtype=\"count\",\n"
")\n"
"\n"
"# Shift plot origin by the previous plot's width (\"w\") plus 2 centimeters "
"to the right\n"
"fig.shift_origin(xshift=\"w+2c\")\n"
"\n"
"# Create histogram for data01 with horizontal bars\n"
"fig.histogram(\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X10c\",\n"
"    frame=Frame(\n"
"        axes=\"WStr\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=1, tick=1, label=\"Counts\"),\n"
"    ),\n"
"    data=data01,\n"
"    series=10,\n"
"    fill=\"red3\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    histtype=\"count\",\n"
"    # Use horizontal bars. Note that the x- and y-axes are flipped, with the "
"x-axis\n"
"    # plotted vertically and the y-axis plotted horizontally.\n"
"    horizontal=True,\n"
")\n"
"\n"
"fig.show()"
