#: ../../../projections/misc/misc_sinusoidal.rst:22
msgid "Sinusoidal projection"
msgstr ""

#: ../../../projections/misc/misc_sinusoidal.rst:24
msgid ""
"The sinusoidal projection is one of the oldest known projections, is equal-"
"area, and has been used since the mid-16th century. It has also been called "
"the \"Equal-area Mercator\" projection. The central meridian is a straight "
"line; all other meridians are sinusoidal curves. Parallels are all equally "
"spaced straight lines, with scale being true along all parallels (and "
"central meridian)."
msgstr ""

#: ../../../projections/misc/misc_sinusoidal.rst:31
msgid "**i**\\ [*lon0/*]\\ *scale* or **I**\\ [*lon0/*]\\ *width*"
msgstr ""

#: ../../../projections/misc/misc_sinusoidal.rst:33
msgid "**i** or **I**: Sets the projection type."
msgstr ""

#: ../../../projections/misc/misc_sinusoidal.rst:34
msgid "*lon0*: Sets the central meridian [Optional]."
msgstr ""

#: ../../../projections/misc/misc_sinusoidal.rst:35
msgid "*scale* or *width*: Sets the map size."
msgstr ""

#: ../../../projections/misc/misc_sinusoidal.rst:39
msgid ""
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"# Use region \"d\" to specify global region (-180/180/-90/90)\n"
"fig.coast(\n"
"    region=\"d\",\n"
"    projection=\"I12c\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
"    land=\"ivory\",\n"
"    water=\"bisque4\",\n"
")\n"
"fig.show()"
msgstr ""

