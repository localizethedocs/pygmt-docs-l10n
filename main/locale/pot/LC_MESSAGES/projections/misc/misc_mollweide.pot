#: ../../../projections/misc/misc_mollweide.rst:22
msgid "Mollweide projection"
msgstr ""

#: ../../../projections/misc/misc_mollweide.rst:24
msgid ""
"This pseudo-cylindrical, equal-area projection was developed by the German "
"mathematician and astronomer Karl Brandan Mollweide in 1805. Parallels are "
"unequally spaced straight lines with the meridians being equally spaced "
"elliptical arcs. The scale is only true along latitudes 40°44' north and "
"south. The projection is used mainly for global maps showing data "
"distributions. It is occasionally referenced under the name homalographic "
"projection."
msgstr ""

#: ../../../projections/misc/misc_mollweide.rst:31
msgid "**w**\\ [*lon0/*]\\ *scale* or **W**\\ [*lon0/*]\\ *width*"
msgstr ""

#: ../../../projections/misc/misc_mollweide.rst:33
msgid "**w** or **W**: Sets the projection type."
msgstr ""

#: ../../../projections/misc/misc_mollweide.rst:34
msgid "*lon0*: Sets the central meridian [Optional]."
msgstr ""

#: ../../../projections/misc/misc_mollweide.rst:35
msgid "*scale* or *width*: Sets the map size."
msgstr ""

#: ../../../projections/misc/misc_mollweide.rst:39
msgid ""
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"# Use region \"d\" to specify global region (-180/180/-90/90)\n"
"fig.coast(\n"
"    region=\"d\",\n"
"    projection=\"W12c\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
"    land=\"ivory\",\n"
"    water=\"bisque4\",\n"
")\n"
"fig.show()"
msgstr ""

