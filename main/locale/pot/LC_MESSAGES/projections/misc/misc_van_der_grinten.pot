#: ../../../projections/misc/misc_van_der_grinten.rst:22
msgid "Van der Grinten projection"
msgstr ""

#: ../../../projections/misc/misc_van_der_grinten.rst:24
msgid ""
"The Van der Grinten projection, presented by Alphons J. van der Grinten in "
"1904, is neither equal-area nor conformal. Central meridian and Equator are "
"straight lines; other meridians are arcs of circles. The scale is true along "
"the Equator only. Its main use is to show the entire world enclosed in a "
"circle."
msgstr ""

#: ../../../projections/misc/misc_van_der_grinten.rst:30
msgid "**v**\\ [*lon0/*]\\ *scale* or **V**\\ [*lon0/*]\\ *width*"
msgstr ""

#: ../../../projections/misc/misc_van_der_grinten.rst:32
msgid "**v** or **V**: Sets the projection type."
msgstr ""

#: ../../../projections/misc/misc_van_der_grinten.rst:33
msgid "*lon0*: Sets the central meridian [Optional]."
msgstr ""

#: ../../../projections/misc/misc_van_der_grinten.rst:34
msgid "*scale* or *width*: Sets the map size."
msgstr ""

#: ../../../projections/misc/misc_van_der_grinten.rst:38
msgid ""
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"# Use region \"d\" to specify global region (-180/180/-90/90)\n"
"fig.coast(\n"
"    region=\"d\",\n"
"    projection=\"V12c\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
"    land=\"ivory\",\n"
"    water=\"bisque4\",\n"
")\n"
"fig.show()"
msgstr ""

