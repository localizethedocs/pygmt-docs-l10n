#: ../../../projections/misc/misc_spilhaus.rst:22
msgid "Spilhaus projection"
msgstr ""

#: ../../../projections/misc/misc_spilhaus.rst:24
msgid ""
"The Spilhaus projection is a world map projection that presents the world's "
"oceans as one contiguous body of water, with Antarctica at the top. It was "
"developed by Athelstan Spilhaus and is useful for oceanographic studies."
msgstr ""

#: ../../../projections/misc/misc_spilhaus.rst:28
msgid ""
"**+proj=spilhaus+scale=**\\ *scale* or **+proj=spilhaus+width=**\\ *width*"
msgstr ""

#: ../../../projections/misc/misc_spilhaus.rst:31
msgid "**+proj=spilhaus**: Sets the projection type."
msgstr ""

#: ../../../projections/misc/misc_spilhaus.rst:32
msgid "*scale* or *width*: Sets the map size."
msgstr ""

#: ../../../projections/misc/misc_spilhaus.rst:36
msgid ""
"This projection works well for coastlines but currently has issues for "
"filling land and water masses."
msgstr ""

#: ../../../projections/misc/misc_spilhaus.rst:41
msgid ""
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"# Use the PROJ string to set the Spilhaus projection\n"
"fig.coast(\n"
"    region=\"d\",\n"
"    projection=\"+proj=spilhaus+width=12c\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
"    shorelines=True,\n"
")\n"
"fig.show()"
msgstr ""

