#: ../../../projections/misc/misc_eckertVI.rst:22
msgid "Eckert VI equal-area projection"
msgstr ""

#: ../../../projections/misc/misc_eckertVI.rst:24
msgid ""
"The Eckert VI projections, presented by the German cartographer Max Eckert-"
"Greiffendorff in 1906, is a pseudo-cylindrical equal-area projection. "
"Central meridian and all parallels are straight lines; other meridians are "
"equally spaced sinusoids. The scale is true along latitude 49°16'."
msgstr ""

#: ../../../projections/misc/misc_eckertVI.rst:30
msgid "**ks**\\ [*lon0/*]\\ *scale* or **Ks**\\ [*lon0/*]\\ *width*"
msgstr ""

#: ../../../projections/misc/misc_eckertVI.rst:32
msgid "**ks** or **Ks**: Sets the projection type."
msgstr ""

#: ../../../projections/misc/misc_eckertVI.rst:33
msgid "*lon0*: Sets the central meridian [Optional]."
msgstr ""

#: ../../../projections/misc/misc_eckertVI.rst:34
msgid "*scale* or *width*: Sets the map size."
msgstr ""

#: ../../../projections/misc/misc_eckertVI.rst:38
msgid ""
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"# Use region \"d\" to specify global region (-180/180/-90/90)\n"
"fig.coast(\n"
"    region=\"d\",\n"
"    projection=\"Ks12c\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
"    land=\"ivory\",\n"
"    water=\"bisque4\",\n"
")\n"
"fig.show()"
msgstr ""

