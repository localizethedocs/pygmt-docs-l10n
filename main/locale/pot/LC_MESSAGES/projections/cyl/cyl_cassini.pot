#: ../../../projections/cyl/cyl_cassini.rst:42
msgid ""
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"# Use the ISO code for Madagascar (MG) and pad it by 2 degrees (+R2)\n"
"fig.coast(\n"
"    region=\"MG+R2\",\n"
"    projection=\"C47/-19/12c\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
"    land=\"gray80\",\n"
"    water=\"steelblue\",\n"
")\n"
"fig.show()"
msgstr ""

