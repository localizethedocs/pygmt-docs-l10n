#: ../../../projections/azim/azim_orthographic.rst:22
msgid "Orthographic projection"
msgstr ""

#: ../../../projections/azim/azim_orthographic.rst:24
msgid ""
"This is a perspective projection like the general perspective, but with the "
"difference that the point of perspective lies in infinite distance. It is "
"therefore often used to give the appearance of a globe viewed from outer "
"space, were one hemisphere can be seen as a whole. It is neither conformal "
"nor equal-area and the distortion increases near the edges."
msgstr ""

#: ../../../projections/azim/azim_orthographic.rst:30
msgid ""
"**g**\\ *lon0/lat0*\\ [*/horizon*]\\ */scale* or **G**\\ *lon0/lat0*\\ [*/"
"horizon*]\\ */width*"
msgstr ""

#: ../../../projections/azim/azim_orthographic.rst:33
msgid "**g** or **G**: Sets the projection type."
msgstr ""

#: ../../../projections/azim/azim_orthographic.rst:34
msgid "*lon0/lat0*: Sets the projection center."
msgstr ""

#: ../../../projections/azim/azim_orthographic.rst:35
msgid ""
"*horizon*: Sets the maximum distance from the projection center in degrees "
"(<= 90°) [Optional, default is 90°]."
msgstr ""

#: ../../../projections/azim/azim_orthographic.rst:37
msgid "*scale* or *width*: Sets the map size."
msgstr ""

#: ../../../projections/azim/azim_orthographic.rst:41
msgid ""
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"fig.coast(\n"
"    region=\"g\",\n"
"    projection=\"G10/52/12c\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
"    land=\"khaki\",\n"
"    water=\"white\",\n"
")\n"
"fig.show()"
msgstr ""

