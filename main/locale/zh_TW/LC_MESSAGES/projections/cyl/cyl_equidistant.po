#: ../../../projections/cyl/cyl_equidistant.rst:22
msgid "Cylindrical equidistant projection"
msgstr ""

#: ../../../projections/cyl/cyl_equidistant.rst:24
msgid ""
"This simple cylindrical projection is really a linear scaling of longitudes "
"and latitudes. The most common form is the Plate Carrée projection, where "
"the scaling of longitudes and latitudes is the same. All meridians and "
"parallels are straight lines."
msgstr ""

#: ../../../projections/cyl/cyl_equidistant.rst:29
msgid ""
"**q**\\ [*lon0*/\\ [*lat0*/]]\\ *scale* or **Q**\\ [*lon0*/\\ [*lat0*/]]\\ "
"*width*"
msgstr ""

#: ../../../projections/cyl/cyl_equidistant.rst:31
msgid "**q** or **Q**: Sets the projection type."
msgstr ""

#: ../../../projections/cyl/cyl_equidistant.rst:32
msgid ""
"*lon0*: Sets the central meridian [Optional, default is the middle of the "
"map]."
msgstr ""

#: ../../../projections/cyl/cyl_equidistant.rst:33
msgid ""
"*lat0*: Sets the standard parallel [Optional, default is the equator]. When "
"supplied, *lon0* must be supplied as well."
msgstr ""

#: ../../../projections/cyl/cyl_equidistant.rst:35
msgid "*scale* or *width*: Sets the map size."
msgstr ""

#: ../../../projections/cyl/cyl_equidistant.rst:39
msgid ""
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"# Use region \"d\" to specify global region (-180/180/-90/90)\n"
"fig.coast(\n"
"    region=\"d\",\n"
"    projection=\"Q12c\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
"    land=\"gray80\",\n"
"    water=\"steelblue\",\n"
")\n"
"fig.show()"
msgstr ""

