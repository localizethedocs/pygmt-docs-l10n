#: ../../../projections/nongeo/polar.rst:22
msgid "Polar"
msgstr ""

#: ../../../projections/nongeo/polar.rst:24
msgid ""
"Polar projections allow plotting polar coordinate data (e.g. angle :math:"
"`\\theta` and radius *r*)."
msgstr ""

#: ../../../projections/nongeo/polar.rst:27
msgid "The full syntax for polar projections is:"
msgstr ""

#: ../../../projections/nongeo/polar.rst:29
msgid ""
"**P**\\ *width*\\ [**+a**]\\ [**+f**\\ [**e**\\|\\ **p**\\|\\ *radius*]] "
"[**+r**\\ *offset*][**+t**\\ *origin*][**+z**\\ [**p**\\|\\ *radius*]]"
msgstr ""

#: ../../../projections/nongeo/polar.rst:32
msgid ""
"Limits are set via the ``region`` parameter ([*theta_min*, *theta_max*, "
"*radius_min*, *radius_max*]). When using **P**\\ *width* you have to give "
"the *width* of the plot. The lowercase version **p** is similar to **P** but "
"expects a *scale* instead of a width (**p**\\ *scale*)."
msgstr ""

#: ../../../projections/nongeo/polar.rst:37
msgid "The following customizing modifiers are available:"
msgstr ""

#: ../../../projections/nongeo/polar.rst:39
msgid ""
"**+a**: by default, :math:`\\theta` refers to the angle that is equivalent "
"to a counterclockwise rotation with respect to the east direction (standard "
"definition); **+a** indicates that the input data are rotated clockwise "
"relative to the north direction (geographical azimuth angle) [Optional]."
msgstr ""

#: ../../../projections/nongeo/polar.rst:44
msgid ""
"**+r**\\ *offset*: represents the offset of the r-axis. This modifier allows "
"you to offset the center of the circle from r=0 [Optional]."
msgstr ""

#: ../../../projections/nongeo/polar.rst:47
msgid ""
"**+t**\\ *origin*: sets the angle corresponding to the east direction which "
"is equivalent to rotating the entire coordinate axis clockwise; if the "
"**+a** modifier is used, setting the angle corresponding to the north "
"direction is equivalent to rotating the entire coordinate axis "
"counterclockwise [Optional]."
msgstr ""

#: ../../../projections/nongeo/polar.rst:52
msgid "**+f**: reverses the radial direction [Optional]."
msgstr ""

#: ../../../projections/nongeo/polar.rst:54
msgid ""
"Append **e** to indicate that the r-axis is an elevation angle, and the "
"range of the r-axis should be between 0° and 90°."
msgstr ""

#: ../../../projections/nongeo/polar.rst:56
msgid ""
"Appending **p** sets the current Earth's radius (determined by :gmt-term:"
"`PROJ_ELLIPSOID`) to the maximum value of the r-axis when the r-axis is "
"reversed."
msgstr ""

#: ../../../projections/nongeo/polar.rst:59
msgid "Append *radius* to set the maximum value of the r-axis."
msgstr ""

#: ../../../projections/nongeo/polar.rst:61
msgid ""
"**+z**: indicates that the r-axis is marked as depth instead of radius (e."
"g., *r = radius - z*) [Optional]."
msgstr ""

#: ../../../projections/nongeo/polar.rst:64
msgid "Append **p** to set radius to the current Earth's radius."
msgstr ""

#: ../../../projections/nongeo/polar.rst:65
msgid "Append *radius* to set the value of the radius."
msgstr ""

#: ../../../projections/nongeo/polar.rst:69
msgid ""
"import pygmt\n"
"from pygmt.params import Axis, Frame\n"
"\n"
"fig = pygmt.Figure()\n"
"\n"
"pygmt.config(FONT_TITLE=\"14p,Courier,black\", FORMAT_GEO_MAP=\"+D\")\n"
"\n"
"# ============\n"
"# Top left\n"
"fig.basemap(\n"
"    # Set plot limits to theta_min = 0, theta_max = 360, radius_min = 0, "
"radius_max = 1\n"
"    region=[0, 360, 0, 1],\n"
"    # Set plot width to 5 cm\n"
"    projection=\"P5c\",\n"
"    # Set the frame and title; @^ allows for a line break within the title\n"
"    frame=Frame(\n"
"        fill=\"bisque\",\n"
"        title=\"projection='P5c' @^ region=[0, 360, 0, 1]\",\n"
"        xaxis=Axis(annot=45, tick=True),\n"
"    ),\n"
")\n"
"\n"
"fig.shift_origin(xshift=\"w+3c\")\n"
"\n"
"# ============\n"
"# Top middle\n"
"fig.basemap(\n"
"    # Set plot limits to theta_min = 0, theta_max = 360, radius_min = 0, "
"radius_max = 1\n"
"    region=[0, 360, 0, 1],\n"
"    # Set plot width to 5 cm and interpret input data as geographic azimuth "
"instead of\n"
"    # standard angle\n"
"    projection=\"P5c+a\",\n"
"    # Set the frame and title; @^ allows for a line break within the title\n"
"    frame=Frame(\n"
"        fill=\"bisque\",\n"
"        title=\"projection='P5c+a' @^ region=[0, 360, 0, 1]\",\n"
"        xaxis=Axis(annot=45, tick=True),\n"
"    ),\n"
")\n"
"\n"
"fig.shift_origin(xshift=\"w+3c\")\n"
"\n"
"# ============\n"
"# Top right\n"
"fig.basemap(\n"
"    # Set plot limits to theta_min = 0, theta_max = 90, radius_min = 0, "
"radius_max = 1\n"
"    region=[0, 90, 0, 1],\n"
"    # Set plot width to 5 cm and interpret input data as geographic azimuth "
"instead of\n"
"    # standard angle\n"
"    projection=\"P5c+a\",\n"
"    # Set the frame and title; @^ allows for a line break within the title\n"
"    frame=Frame(\n"
"        axes=\"WNe\",\n"
"        fill=\"bisque\",\n"
"        title=\"projection='P5c+a' @^ region=[0, 90, 0, 1]\",\n"
"        xaxis=Axis(annot=45, tick=True),\n"
"        yaxis=Axis(annot=0.2),\n"
"    ),\n"
")\n"
"\n"
"fig.shift_origin(xshift=\"-2w-6c\", yshift=\"-h-2c\")\n"
"\n"
"# ============\n"
"# Bottom left\n"
"fig.basemap(\n"
"    # Set plot limits to theta_min = 0, theta_max = 90, radius_min = 0, "
"radius_max = 1\n"
"    region=[0, 90, 0, 1],\n"
"    # Set plot width to 5 cm and interpret input data as geographic azimuth "
"instead of\n"
"    # standard angle, rotate coordinate system counterclockwise by 45 "
"degrees\n"
"    projection=\"P5c+a+t45\",\n"
"    # Set the frame and title; @^ allows for a line break within the title\n"
"    frame=Frame(\n"
"        axes=\"WNe\",\n"
"        fill=\"bisque\",\n"
"        title=\"projection='P5c+a+t45' @^ region=[0, 90, 0, 1]\",\n"
"        xaxis=Axis(annot=30, tick=True),\n"
"        yaxis=Axis(annot=0.2),\n"
"    ),\n"
")\n"
"\n"
"fig.shift_origin(xshift=\"w+3c\", yshift=\"1.3c\")\n"
"\n"
"# ============\n"
"# Bottom middle\n"
"fig.basemap(\n"
"    # Set plot limits to theta_min = 0, theta_max = 90, radius_min = 3480,\n"
"    # radius_max = 6371 (Earth's radius)\n"
"    region=[0, 90, 3480, 6371],\n"
"    # Set plot width to 5 cm and interpret input data as geographic azimuth "
"instead of\n"
"    # standard angle, rotate coordinate system counterclockwise by 45 "
"degrees\n"
"    projection=\"P5c+a+t45\",\n"
"    # Set the frame, and title; @^ allows for a line break within the title\n"
"    frame=Frame(\n"
"        axes=\"WNse\",\n"
"        fill=\"bisque\",\n"
"        title=\"projection='P5c+a+t45' @^ region=[0, 90, 3480, 6371]\",\n"
"        xaxis=Axis(annot=30, tick=True),\n"
"        yaxis=Axis(annot=True),\n"
"    ),\n"
")\n"
"\n"
"fig.shift_origin(xshift=\"w+3c\")\n"
"\n"
"# ============\n"
"# Bottom right\n"
"fig.basemap(\n"
"    # Set plot limits to theta_min = 0, theta_max = 90, radius_min = 3480,\n"
"    # radius_max = 6371 (Earth's radius)\n"
"    region=[0, 90, 3480, 6371],\n"
"    # Set plot width to 5 cm and interpret input data as geographic azimuth "
"instead of\n"
"    # standard angle, rotate coordinate system counterclockwise by 45 "
"degrees, r-axis\n"
"    # is marked as depth\n"
"    projection=\"P5c+a+t45+z\",\n"
"    # Set the frame, and title; @^ allows for a line break within the title\n"
"    frame=Frame(\n"
"        axes=\"WNse\",\n"
"        fill=\"bisque\",\n"
"        title=\"projection='P5c+a+t45+\\\\z' @^ region=[0, 90, 3480, "
"6371]\",\n"
"        xaxis=Axis(annot=30, tick=True),\n"
"        yaxis=Axis(annot=True),\n"
"    ),\n"
")\n"
"\n"
"fig.show()"
msgstr ""

