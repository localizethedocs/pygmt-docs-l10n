#: ../../../projections/conic/conic_equidistant.rst:22
msgid "Equidistant conic projection"
msgstr ""

#: ../../../projections/conic/conic_equidistant.rst:24
msgid ""
"The equidistant conic projection was described by the Greek philosopher "
"Claudius Ptolemy about A.D. 150. It is neither conformal or equal-area, but "
"serves as a compromise between them. The scale is true along all meridians "
"and the standard parallels."
msgstr ""

#: ../../../projections/conic/conic_equidistant.rst:29
msgid ""
"**d**\\ *lon0/lat0*\\ /\\ *lat1/lat2*\\ */scale* or **D**\\ *lon0/lat0*\\ /"
"\\ *lat1/lat2*\\ */width*"
msgstr ""

#: ../../../projections/conic/conic_equidistant.rst:32
msgid "**d** or **D**: Sets the projection type."
msgstr ""

#: ../../../projections/conic/conic_equidistant.rst:33
msgid "*lon0/lat0*: Sets the projection center."
msgstr ""

#: ../../../projections/conic/conic_equidistant.rst:34
msgid "*lat1/lat2*: Sets the two standard parallels."
msgstr ""

#: ../../../projections/conic/conic_equidistant.rst:35
msgid "*scale* or *width*: Sets the map size."
msgstr ""

#: ../../../projections/conic/conic_equidistant.rst:39
msgid ""
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"fig.coast(\n"
"    region=[-88, -70, 18, 24],\n"
"    projection=\"D-79/21/19/23/12c\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
"    land=\"seagreen\",\n"
"    water=\"gray90\",\n"
")\n"
"fig.show()"
msgstr ""

