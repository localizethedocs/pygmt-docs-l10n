#: ../../../projections/misc/misc_hammer.rst:22
msgid "Hammer projection"
msgstr ""

#: ../../../projections/misc/misc_hammer.rst:24
msgid ""
"The equal-area Hammer projection, first presented by the German "
"mathematician Ernst von Hammer in 1892, is also known as Hammer-Aitoff (the "
"Aitoff projection looks similar, but is not equal-area). The border is an "
"ellipse, equator and central meridian are straight lines, while other "
"parallels and meridians are complex curves."
msgstr ""

#: ../../../projections/misc/misc_hammer.rst:30
msgid "**h**\\ [*lon0/*]\\ *scale* or **H**\\ [*lon0/*]\\ *width*"
msgstr ""

#: ../../../projections/misc/misc_hammer.rst:32
msgid "**h** or **H**: Sets the projection type."
msgstr ""

#: ../../../projections/misc/misc_hammer.rst:33
msgid "*lon0*: Sets the central meridian [Optional]."
msgstr ""

#: ../../../projections/misc/misc_hammer.rst:34
msgid "*scale* or *width*: Sets the map size."
msgstr ""

#: ../../../projections/misc/misc_hammer.rst:38
msgid ""
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"# Use region \"d\" to specify global region (-180/180/-90/90)\n"
"fig.coast(\n"
"    region=\"d\",\n"
"    projection=\"H12c\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
"    land=\"ivory\",\n"
"    water=\"bisque4\",\n"
")\n"
"fig.show()"
msgstr ""

