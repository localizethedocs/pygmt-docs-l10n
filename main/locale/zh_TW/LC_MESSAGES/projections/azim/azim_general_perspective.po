#: ../../../projections/azim/azim_general_perspective.rst:22
msgid "Perspective projection"
msgstr ""

#: ../../../projections/azim/azim_general_perspective.rst:24
msgid ""
"The perspective projection imitates the view of the Earth from a finite "
"point in space. In a full view of the earth one third of its surface area "
"can be seen."
msgstr ""

#: ../../../projections/azim/azim_general_perspective.rst:28
msgid ""
"**g**\\ *lon0/lat0*\\ */scale*\\ [**+a**\\ *azimuth*] [**+t**\\ *tilt*]\\ "
"[**+v**\\ *vwidth/vheight*]\\ [**+w**\\ *twist*] [**+z**\\ *altitude*] or "
"**G**\\ *lon0/lat0*\\ */width* [**+a**\\ *azimuth*]\\ [**+t**\\ *tilt*]\\ "
"[**+v**\\ *vwidth/vheight*] [**+w**\\ *twist*]\\ [**+z**\\ *altitude*]"
msgstr ""

#: ../../../projections/azim/azim_general_perspective.rst:34
msgid "**g** or **G**: Sets the projection type."
msgstr ""

#: ../../../projections/azim/azim_general_perspective.rst:35
msgid "*lon0/lat0*: Sets the projection center."
msgstr ""

#: ../../../projections/azim/azim_general_perspective.rst:36
msgid "*scale* or *width*: Sets the map size."
msgstr ""

#: ../../../projections/azim/azim_general_perspective.rst:37
msgid ""
"**+a**\\ *azimuth*: The direction in which you are looking, measured "
"clockwise from north in degrees [Optional]."
msgstr ""

#: ../../../projections/azim/azim_general_perspective.rst:39
msgid ""
"**+t**\\ *tilt*: The viewing angle relative to zenith in degrees. A tilt of "
"0° is looking straight down, 60° is looking 30° above horizon [Optional]."
msgstr ""

#: ../../../projections/azim/azim_general_perspective.rst:41
msgid "**+v**\\ *vwidth/vheight*: The viewport angle in degrees [Optional]."
msgstr ""

#: ../../../projections/azim/azim_general_perspective.rst:42
msgid ""
"**+w**\\ *twist*: The clockwise rotation of the image in degrees [Optional]."
msgstr ""

#: ../../../projections/azim/azim_general_perspective.rst:43
msgid ""
"**+z**\\ *altitude*: The height of the viewpoint above local sea level in "
"km. If altitude is less than 10, it is the distance from the center of the "
"earth to the viewpoint in earth radii [Optional]."
msgstr ""

#: ../../../projections/azim/azim_general_perspective.rst:47
msgid ""
"The example shows the coast of Northern Europe viewed from 250 km above sea "
"level looking 30° from north at a tilt of 45°. The height and width of the "
"viewing angle is both 60°, which imitates viewing with naked eye."
msgstr ""

#: ../../../projections/azim/azim_general_perspective.rst:53
msgid ""
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"fig.coast(\n"
"    region=\"g\",\n"
"    projection=\"G4/52/12c+a30+t45+v60/60+w0+z250\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
"    land=\"khaki\",\n"
"    water=\"white\",\n"
")\n"
"fig.show()"
msgstr ""

