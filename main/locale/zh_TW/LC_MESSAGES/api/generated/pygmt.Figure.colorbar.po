#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:55
msgid ""
"File name of a CPT file or a series of comma-separated colors (e.g., "
"*color1*,\\ *color2*,\\ *color3*) to build a linear continuous CPT from "
"those colors automatically."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:60
msgid ""
"Position of the colorbar on the plot. It can be specified in multiple ways:  "
"- A :class:`pygmt.params.Position` object to fully control the reference "
"point,   anchor point, and offset. - A sequence of two values representing "
"the x- and y-coordinates in plot   coordinates, e.g., ``(1, 2)`` or "
"``(\"1c\", \"2c\")``. - A :doc:`2-character justification code </techref/"
"justification_codes>` for a   position inside the plot, e.g., ``\"TL\"`` for "
"Top Left corner inside the plot.  If not specified, defaults to bottom-"
"center outside of the plot."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:60
msgid ""
"Position of the colorbar on the plot. It can be specified in multiple ways:"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:62
msgid ""
"A :class:`pygmt.params.Position` object to fully control the reference "
"point, anchor point, and offset."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:64
msgid ""
"A sequence of two values representing the x- and y-coordinates in plot "
"coordinates, e.g., ``(1, 2)`` or ``(\"1c\", \"2c\")``."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:66
msgid ""
"A :doc:`2-character justification code </techref/justification_codes>` for a "
"position inside the plot, e.g., ``\"TL\"`` for Top Left corner inside the "
"plot."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:69
msgid "If not specified, defaults to bottom-center outside of the plot."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:73
msgid ""
"Length and width of the colorbar. If length is given with a unit ``%`` then "
"it is in percentage of the corresponding plot side dimension (i.e., plot "
"width for a horizontal colorbar, or plot height for a vertical colorbar). If "
"width is given with unit ``%`` then it is in percentage of the bar length. "
"[Length defaults to 80% of the corresponding plot side dimension, and width "
"defaults to 4% of the bar length]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:82
msgid ""
"Set the label and unit for the colorbar. The label is placed along the "
"colorbar and the unit is placed at the end of the colorbar."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:89
msgid ""
"Intervals for annotations, ticks, and gridlines. Refer to :class:`pygmt."
"params.Axis` for more details on how these parameters work."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:96
msgid ""
"The prefix, unit and angle for the annotations. The prefix is placed before "
"the annotation text; the unit is placed after the annotation text; and the "
"angle is the angle of the annotation text."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:100
msgid ""
"Set colorbar boundary frame, labels, and axes attributes. If ``frame=True``, "
"a default frame will be drawn. If ``frame=\"none\"``, no frame will be "
"drawn. Raw GMT strings or sequences of strings are also supported for "
"backward compatibility. For more control over the frame attributes, use "
"parameters such as ``annot``, ``tick``, ``grid``, ``annot_angle``, "
"``annot_prefix``, ``annot_unit``, ``label``, and ``unit`` instead."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:107
msgid ""
"Set the colorbar orientation to either ``\"horizontal\"`` or "
"``\"vertical\"``. [Default is vertical, unless ``position`` is set to bottom-"
"center or top-center with ``cstype=\"outside\"`` or ``cstype=\"inside\"``, "
"then horizontal is the default]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:112
msgid "Reverse the positive direction of the bar."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:114
msgid ""
"Draw a rectangle filled with the NaN color (via the **N** entry in the CPT "
"or :gmt-term:`COLOR_NAN` if no such entry) at the start or end of the "
"colorbar (controlled via ``nan_position``). If a string is given, use that "
"string as the label for the NaN color."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:119
msgid ""
"Set the position of the NaN rectangle. Choose either ``\"start\"`` or "
"``\"end\"`` to place the NaN color rectangle at the start or end of the "
"colorbar [Default is ``\"start\"``]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:125
msgid ""
"If ``True``, draw triangles for the back- or foreground colors [Default is "
"no triangles]. The back- and/or foreground colors are taken from the **B** "
"and **F** entries in the CPT. If no such entries exist, then the system "
"default colors for **B** and **F** are used instead (:gmt-term:"
"`COLOR_BACKGROUND` and :gmt-term:`COLOR_FOREGROUND`)."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:131
msgid ""
"Height of the triangles for back- and foreground colors [Default is half of "
"the bar width]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:134
msgid ""
"Move text (annotations, label, and unit) to opposite side. Accept a sequence "
"of strings containing one or more of ``\"annotations\"``, ``\"label\"``, and "
"``\"unit\"``. The default placements of these texts depend on the colorbar "
"orientation and position."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:139
msgid ""
"Print a vertical label as a column of characters (does not work with special "
"characters)."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:142
msgid ""
"Draw a background box behind the colorbar. If set to ``True``, a simple "
"rectangular box is drawn using :gmt-term:`MAP_FRAME_PEN`. To customize the "
"box appearance, pass a :class:`pygmt.params.Box` object to control style, "
"fill, pen, and other box properties."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:147
msgid ""
"(*zlow*, *zhigh*). Truncate the incoming CPT so that the lowest and highest "
"z-levels are to *zlow* and *zhigh*. If one of these equal NaN then we leave "
"that end of the CPT alone. The truncation takes place before the plotting."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:152
msgid ""
"Multiply all z-values in the CPT by the provided scale. By default, the CPT "
"is used as is."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:155
msgid ""
"Add illumination effects [Default is no illumination].  - If ``True``, a "
"default intensity range of -1 to +1 is used. - Passing a single numerical "
"value *max_intens* sets the range of intensities   from *-max_intens* to "
"*+max_intens*. - Passing a sequence of two numerical values (*low*, *high*) "
"sets the intensity   range from *low* to *high* to specify an asymmetric "
"range."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:155
msgid "Add illumination effects [Default is no illumination]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:157
msgid "If ``True``, a default intensity range of -1 to +1 is used."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:158
msgid ""
"Passing a single numerical value *max_intens* sets the range of intensities "
"from *-max_intens* to *+max_intens*."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:160
msgid ""
"Passing a sequence of two numerical values (*low*, *high*) sets the "
"intensity range from *low* to *high* to specify an asymmetric range."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:162
msgid ""
"[**i**]\\ [*gap*]. Equal-sized color rectangles. By default, the rectangles "
"are scaled according to the z-range in the CPT (see also ``zfile``). If "
"*gap* is appended and the CPT is discrete each annotation is centered on "
"each rectangle, using the lower boundary z-value for the annotation. If "
"**i** is prepended the interval range is annotated instead. If ``shading`` "
"is used each rectangle will have its constant color modified by the "
"specified intensity."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:172
msgid ""
"Select logarithmic scale and power of ten annotations. All z-values in the "
"CPT will be converted to :math:`p = \\log_{10}(z)` and only integer p values "
"will be annotated using the :math:`10^{p}` format [Default is linear scale]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:175
msgid ""
"File with colorbar-width per color entry. By default, the width of the entry "
"is scaled to the color range, i.e., z = 0-100 gives twice the width as z = "
"100-150 (see also ``equalsize``). **Note**: The widths may be in plot "
"distance units or given as relative fractions and will be automatically "
"scaled so that the sum of the widths equals the requested colorbar length."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:183
msgid "Force a monochrome graybar using the (television) YIQ transformation."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:185
msgid ""
"Control how the color scale should be encoded graphically.  - Use a positive "
"integer to draw the color scale as image and set the effective   dots-per-"
"inch for rasterization of color scales, which is useful for   continuous "
"colormaps. - Use ``dpi=0`` to draw color rectangles, which is useful for "
"discrete   colormaps.  If not specified, GMT uses its default encoding "
"behavior, and the default dpi is 600 if the colorbar is drawn as image."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:185
msgid "Control how the color scale should be encoded graphically."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:187
msgid ""
"Use a positive integer to draw the color scale as image and set the "
"effective dots-per-inch for rasterization of color scales, which is useful "
"for continuous colormaps."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:190
msgid ""
"Use ``dpi=0`` to draw color rectangles, which is useful for discrete "
"colormaps."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:193
msgid ""
"If not specified, GMT uses its default encoding behavior, and the default "
"dpi is 600 if the colorbar is drawn as image."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:196
msgid ""
"*projcode*\\[*projparams*/]\\ *width*\\|\\ *scale*. Select map :doc:"
"`projection </projections/index>`."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:198
msgid ""
"[*xmin*, *xmax*, *ymin*, *ymax*] or *xmin/xmax/ymin/ymax*\\ [**+r**]"
"[**+u**\\ *unit*]. Specify the :doc:`region </tutorials/basics/regions>` of "
"interest."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:202
msgid "Select verbosity level [:term:`Full usage <verbose>`]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:205
msgid ""
"Select a specific subplot panel. Only allowed when used in :meth:`Figure."
"subplot` mode.  - ``True`` to advance to the next panel in the selected "
"order. - *index* to specify the index of the desired panel. - (*row*, *col*) "
"to specify the row and column of the desired panel.  The panel order is "
"determined by the :meth:`Figure.subplot` method. *row*, *col* and *index* "
"all start at 0."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:205
msgid ""
"Select a specific subplot panel. Only allowed when used in :meth:`Figure."
"subplot` mode."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:208
msgid "``True`` to advance to the next panel in the selected order."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:209
msgid "*index* to specify the index of the desired panel."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:210
msgid "(*row*, *col*) to specify the row and column of the desired panel."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:212
msgid ""
"The panel order is determined by the :meth:`Figure.subplot` method. *row*, "
"*col* and *index* all start at 0."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:215
msgid ""
"Select perspective view and set the azimuth and elevation of the viewpoint.  "
"Accepts a single value or a sequence of two or three values: *azimuth*, "
"(*azimuth*, *elevation*), or (*azimuth*, *elevation*, *zlevel*).  - "
"*azimuth*: Azimuth angle of the viewpoint in degrees [Default is 180,   i."
"e., looking from south to north]. - *elevation*: Elevation angle of the "
"viewpoint above the horizon [Default   is 90, i.e., looking straight down at "
"nadir]. - *zlevel*: Z-level at which 2-D elements (e.g., the plot frame) are "
"drawn.   Only applied when used together with ``zsize`` or ``zscale``. "
"[Default is   at the bottom of the z-axis].  Alternatively, set "
"``perspective=True`` to reuse the perspective setting from the previous "
"plotting method, or pass a string following the full GMT syntax for finer "
"control (e.g., adding ``+w`` or ``+v`` modifiers to select an axis location "
"other than the plot origin). See :gmt-docs:`gmt.html#perspective-full` for "
"details."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:215
msgid ""
"Select perspective view and set the azimuth and elevation of the viewpoint."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:217
msgid ""
"Accepts a single value or a sequence of two or three values: *azimuth*, "
"(*azimuth*, *elevation*), or (*azimuth*, *elevation*, *zlevel*)."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:220
msgid ""
"*azimuth*: Azimuth angle of the viewpoint in degrees [Default is 180, i.e., "
"looking from south to north]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:222
msgid ""
"*elevation*: Elevation angle of the viewpoint above the horizon [Default is "
"90, i.e., looking straight down at nadir]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:224
msgid ""
"*zlevel*: Z-level at which 2-D elements (e.g., the plot frame) are drawn. "
"Only applied when used together with ``zsize`` or ``zscale``. [Default is at "
"the bottom of the z-axis]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:228
msgid ""
"Alternatively, set ``perspective=True`` to reuse the perspective setting "
"from the previous plotting method, or pass a string following the full GMT "
"syntax for finer control (e.g., adding ``+w`` or ``+v`` modifiers to select "
"an axis location other than the plot origin). See :gmt-docs:`gmt."
"html#perspective-full` for details."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/colorbar.py:docstring
#: of pygmt.src.colorbar.colorbar:233
msgid ""
"Set transparency level, in [0-100] percent range [Default is ``0``, i.e., "
"opaque]. Only visible when PDF or raster format output is selected. Only the "
"PNG format selection adds a transparency layer in the image (for further "
"processing)."
msgstr ""

