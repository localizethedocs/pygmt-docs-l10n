msgid ""
"The image resolution. The suffix ``d``, ``m``, and ``s`` stand for arc-"
"degrees, arc-minutes, and arc-seconds."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/datasets/earth_night.py:docstring
#: of pygmt.datasets.earth_night.load_black_marble:27
