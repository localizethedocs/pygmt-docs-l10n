msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/nearneighbor.py:docstring
#: of pygmt.src.nearneighbor.nearneighbor:176
msgid ""
"**x**\\|\\ **y**\\|\\ **z**\\|\\ **d**\\|\\ **X**\\|\\ **Y**\\| **D**\\ "
"*gap*\\ [**u**][**+a**][**+c**\\ *col*][**+n**\\|\\ **p**]. Examine the "
"spacing between consecutive data points in order to impose breaks in the "
"line. To specify multiple criteria, provide a list with each item containing "
"a string describing one set of criteria.  - **x**\\|\\ **X**: define a gap "
"when there is a large enough   change in the x coordinates (uppercase to use "
"projected coordinates). - **y**\\|\\ **Y**: define a gap when there is a "
"large enough   change in the y coordinates (uppercase to use projected "
"coordinates). - **d**\\|\\ **D**: define a gap when there is a large "
"enough   distance between coordinates (uppercase to use projected "
"coordinates). - **z**: define a gap when there is a large enough change in   "
"the z data. Use **+c**\\ *col* to change the z data column   [Default *col* "
"is 2 (i.e., 3rd column)].  A unit **u** may be appended to the specified "
"*gap*:  - For geographic data (**x**\\|\\ **y**\\|\\ **d**), valid units are "
"**d**,   **m**, **s**, **e**, **f**, **k**, **M**, and **n** [Default is "
"**e**].   See :ref:`distance-units` for meanings of the units. - For "
"projected data (**X**\\|\\ **Y**\\|\\ **D**), valid units are **c**,   "
"**i**, and **p**. See :ref:`dimension-units` for meanings of the units.  "
"Append modifier **+a** to specify that *all* the criteria must be met "
"[default imposes breaks if any one criterion is met].  One of the following "
"modifiers can be appended:  - **+n**: specify that the previous value minus "
"the current   column value must exceed *gap* for a break to be imposed. - "
"**+p**: specify that the current value minus the previous   value must "
"exceed *gap* for a break to be imposed."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/nearneighbor.py:docstring
#: of pygmt.src.nearneighbor.nearneighbor:176
msgid ""
"**x**\\|\\ **y**\\|\\ **z**\\|\\ **d**\\|\\ **X**\\|\\ **Y**\\| **D**\\ "
"*gap*\\ [**u**][**+a**][**+c**\\ *col*][**+n**\\|\\ **p**]. Examine the "
"spacing between consecutive data points in order to impose breaks in the "
"line. To specify multiple criteria, provide a list with each item containing "
"a string describing one set of criteria."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/nearneighbor.py:docstring
#: of pygmt.src.nearneighbor.nearneighbor:183
msgid ""
"**x**\\|\\ **X**: define a gap when there is a large enough change in the x "
"coordinates (uppercase to use projected coordinates)."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/nearneighbor.py:docstring
#: of pygmt.src.nearneighbor.nearneighbor:185
msgid ""
"**y**\\|\\ **Y**: define a gap when there is a large enough change in the y "
"coordinates (uppercase to use projected coordinates)."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/nearneighbor.py:docstring
#: of pygmt.src.nearneighbor.nearneighbor:187
msgid ""
"**d**\\|\\ **D**: define a gap when there is a large enough distance between "
"coordinates (uppercase to use projected coordinates)."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/nearneighbor.py:docstring
#: of pygmt.src.nearneighbor.nearneighbor:189
msgid ""
"**z**: define a gap when there is a large enough change in the z data. Use "
"**+c**\\ *col* to change the z data column [Default *col* is 2 (i.e., 3rd "
"column)]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/nearneighbor.py:docstring
#: of pygmt.src.nearneighbor.nearneighbor:193
msgid "A unit **u** may be appended to the specified *gap*:"
