#: ../../../api/generated/pygmt.clib.Session.destroy.rst:2
msgid "pygmt.clib.Session.destroy"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.destroy:1
msgid "Destroy the currently open GMT API session."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.destroy:5
msgid ""
"Usage of :class:`pygmt.clib.Session` as a context manager in a ``with`` "
"block is preferred over calling :meth:`pygmt.clib.Session.create` and :meth:"
"`pygmt.clib.Session.destroy` manually."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.destroy:9
msgid ""
"Calls ``GMT_Destroy_Session`` to terminate and free the memory of a "
"registered ``GMTAPI_CTRL`` session (the pointer for this struct is stored in "
"the ``session_pointer`` attribute)."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.destroy:13
msgid ""
"Always use this method after you are done using a C API session. The session "
"needs to be destroyed before creating a new one. Otherwise, some of the "
"configuration files might be left behind and can influence subsequent API "
"calls."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.destroy:17
msgid "Sets the ``session_pointer`` attribute to ``None``."
msgstr ""

