#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.virtualfile_out:1
msgid "Create a virtual file or an actual file for storing output data."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.virtualfile_out:3
msgid ""
"If ``fname`` is not given, a virtual file will be created to store the "
"output data into a GMT data container and the function yields the name of "
"the virtual file. Otherwise, the output data will be written into the "
"specified file and the function simply yields the actual file name."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.virtualfile_out:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.virtualfile_out:9
msgid ""
"The data kind of the virtual file to create. Valid values are "
"``\"dataset\"``, ``\"grid\"``, and ``\"image\"``. Ignored if ``fname`` is "
"specified."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.virtualfile_out:12
msgid ""
"The name of the actual file to write the output data. No virtual file will "
"be created."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.virtualfile_out:0
msgid "Yields"
msgstr ""

