#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.put_strings:1
msgid "Attach a 1-D numpy array of dtype str as a column on a GMT dataset."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.put_strings:3
msgid ""
"Use this function to attach string type numpy array data to a GMT dataset "
"and pass it to GMT modules. Wraps ``GMT_Put_Strings``."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.put_strings:6
msgid ""
"The dataset must be created by :meth:`pygmt.clib.Session.create_data` first."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.put_strings:9
msgid ""
"The numpy array must be C contiguous in memory. If it comes from a column "
"slice of a 2-D array, for example, you will have to make a copy. Use :func:"
"`numpy.ascontiguousarray` to make sure your vector is contiguous (it won't "
"copy if it already is)."
msgstr ""

#: ../../../api/generated/pygmt.clib.Session.put_strings.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.put_strings:15
msgid ""
"The ctypes void pointer to a ``GMT_VECTOR``/``GMT_MATRIX`` data container. "
"Create it with :meth:`pygmt.clib.Session.create_data`."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.put_strings:18
msgid ""
"The family type of the dataset. Can be either ``GMT_IS_VECTOR`` or "
"``GMT_IS_MATRIX``."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.put_strings:21
msgid ""
"The array that will be attached to the dataset. Must be a 1-D C contiguous "
"array."
msgstr ""

