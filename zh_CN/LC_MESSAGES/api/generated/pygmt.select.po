msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/select.py:docstring
#: of pygmt.src.select.select:123
msgid ""
"Pass all records whose location is inside specified geographical features. "
"Specify if records should be skipped (s) or kept (k) using 1 of 2 formats:  "
"- *wet/dry*. - *ocean/land/lake/island/pond*.  [Default is s/k/s/k/s (i.e., "
"s/k), which passes all points on dry land]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/select.py:docstring
#: of pygmt.src.select.select:123
msgid ""
"Pass all records whose location is inside specified geographical features. "
"Specify if records should be skipped (s) or kept (k) using 1 of 2 formats:"
msgstr ""

