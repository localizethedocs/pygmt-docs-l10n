#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/grdfill.py:docstring
#: of pygmt.src.grdfill.grdfill:31
msgid ""
"For reading a specific grid file format or applying basic data operations, "
"see :gmt-docs:`gmt.html#grd-inout-full` for the available modifiers."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/grdfill.py:docstring
#: of pygmt.src.grdfill.grdfill:34
msgid ""
"Name of the output netCDF grid file. If not specified, will return an :class:"
"`xarray.DataArray` object. For writing a specific grid file format or "
"applying basic data operations to the output grid, see :gmt-docs:`gmt."
"html#grd-inout-full` for the available modifiers."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/grdfill.py:docstring
#: of pygmt.src.grdfill.grdfill:39
msgid ""
"Fill the holes with a constant value. Specify the constant value to use."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/grdfill.py:docstring
#: of pygmt.src.grdfill.grdfill:41
msgid ""
"Fill the holes with values sampled from another (possibly coarser) grid. "
"Specify the grid (a file name or an :class:`xarray.DataArray`) to use for "
"the fill."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/grdfill.py:docstring
#: of pygmt.src.grdfill.grdfill:44
msgid ""
"Fill the holes with the nearest neighbor. Specify the search radius in "
"pixels. If set to ``True``, the default search radius will be used (:math:"
"`r^2 = \\sqrt{n^2 + m^2}`, where (*n,m*) are the node dimensions of the "
"grid)."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/grdfill.py:docstring
#: of pygmt.src.grdfill.grdfill:49
msgid ""
"Fill the holes with a bicubic spline. Specify the tension value to use. If "
"set to ``True``, no tension will be used."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/grdfill.py:docstring
#: of pygmt.src.grdfill.grdfill:52
msgid ""
"Set the node value used to identify a point as a member of a hole [Default "
"is NaN]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/grdfill.py:docstring
#: of pygmt.src.grdfill.grdfill:55
msgid ""
"Output the bounds of each hole. The bounds are returned as a 2-D numpy array "
"in the form of (west, east, south, north). No grid fill takes place and "
"``outgrid`` is ignored."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/grdfill.py:docstring
#: of pygmt.src.grdfill.grdfill:58
msgid ""
"[*xmin*, *xmax*, *ymin*, *ymax*] or *xmin/xmax/ymin/ymax*\\ [**+r**]"
"[**+u**\\ *unit*]. Specify the :doc:`region </tutorials/basics/regions>` of "
"interest."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/grdfill.py:docstring
#: of pygmt.src.grdfill.grdfill:62
msgid "Select verbosity level [:term:`Full usage <verbose>`]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/grdfill.py:docstring
#: of pygmt.src.grdfill.grdfill:65
msgid ""
"[**i**\\|\\ **o**]\\ *colinfo*. Specify data types of input and/or output "
"columns (time or geographical data). Full documentation is at :gmt-docs:`gmt."
"html#f-full`."
msgstr ""

