#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.get_common:1
msgid ""
"Inquire if a GMT common option has been set and return its current value if "
"possible."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.get_common:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.get_common:5
msgid ""
"The GMT common option to check. Valid options are ``\"B\"``, ``\"I\"``, "
"``\"J\"``, ``\"R\"``, ``\"U\"``, ``\"V\"``, ``\"X\"``, ``\"Y\"``, ``\"a\"``, "
"``\"b\"``, ``\"f\"``, ``\"g\"``, ``\"h\"``, ``\"i\"``, ``\"n\"``, ``\"o\"``, "
"``\"p\"``, ``\"r\"``, ``\"s\"``, ``\"t\"``, and ``\":\"``."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.get_common:0
msgid "Return type"
msgstr ""

