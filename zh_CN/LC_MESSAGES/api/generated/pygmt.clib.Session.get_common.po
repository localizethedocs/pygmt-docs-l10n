#: of pygmt.clib.session.Session.get_common:10
msgid ""
":sphinx_autodoc_typehints_type:`\\:py\\:class\\:\\`bool\\` \\| \\:py\\:"
"class\\:\\`int\\` \\| \\:py\\:class\\:\\`float\\` \\| \\:py\\:class\\:"
"\\`\\~numpy.ndarray\\``"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.get_common:0
msgid "Returns"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.get_common:11
msgid ""
"*value* -- Whether the option was set or its value. If the option was not "
"set, return ``False``. Otherwise, the return value depends on the choice of "
"the option.  - options ``\"B\"``, ``\"J\"``, ``\"U\"``, ``\"g\"``, "
"``\"n\"``, ``\"p\"``, and ``\"s\"``:   return ``True`` if set, else "
"``False`` (bool) - ``\"I\"``: 2-element array for the increments (float) - "
"``\"R\"``: 4-element array for the region (float) - ``\"V\"``: the verbose "
"level (int) - ``\"X\"``: the xshift (float) - ``\"Y\"``: the yshift (float) "
"- ``\"a\"``: geometry of the dataset (int) - ``\"b\"``: return 0 if ``-bi`` "
"was set and 1 if ``-bo`` was set (int) - ``\"f\"``: return 0 if ``-fi`` was "
"set and 1 if ``-fo`` was set (int) - ``\"h\"``: whether to delete existing "
"header records (int) - ``\"i\"``: number of input columns (int) - ``\"o\"``: "
"number of output columns (int) - ``\"r\"``: registration type (int) - "
"``\"t\"``: 2-element array for the transparency (float) - ``\":\"``: return "
"0 if ``-:i`` was set and 1 if ``-:o`` was set (int)"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.get_common:11
msgid ""
"*value* -- Whether the option was set or its value. If the option was not "
"set, return ``False``. Otherwise, the return value depends on the choice of "
"the option."
msgstr ""

