msgid "pygmt.params.Box"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/box.py:docstring
#: of pygmt.params.box.Box:1
msgid "Class for specifying the box around GMT embellishments."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/box.py:docstring
#: of pygmt.params.box.Box:4
msgid "Examples"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/box.py:docstring
#: of pygmt.params.Box.clearance:1
msgid ""
"Set clearances between the embellishment and the box border. It can be "
"either a scalar value or a sequence of two/four values."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/box.py:docstring
#: of pygmt.params.Box.clearance:4
msgid "a scalar value means a uniform clearance in all four directions."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/box.py:docstring
#: of pygmt.params.Box.clearance:5
msgid ""
"a sequence of two values means separate clearances in x- and y-directions."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/box.py:docstring
#: of pygmt.params.Box.clearance:6
msgid ""
"a sequence of four values means separate clearances for left/right/bottom/"
"top."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/box.py:docstring
#: of pygmt.params.Box.fill:1
msgid "Fill for the box [Default is no fill]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/box.py:docstring
#: of pygmt.params.Box.inner_gap:1
msgid "Gap between the outer and inner borders [Default is ``\"2p\"``]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/box.py:docstring
#: of pygmt.params.Box.inner_pen:1
msgid ""
"Pen attributes for the inner border [Default to :gmt-term:`MAP_DEFAULT_PEN`]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/box.py:docstring
#: of pygmt.params.Box.pen:1
msgid "Pen attributes for the box outline."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/box.py:docstring
#: of pygmt.params.Box.radius:1
msgid ""
"Draw a rounded rectangular border instead of sharp. Passing a value with "
"unit to control the corner radius [Default is ``\"6p\"``]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/box.py:docstring
#: of pygmt.params.Box.shade_offset:1
msgid ""
"Place an offset background shaded region behind the box. A sequence of two "
"values (dx, dy) indicates the shift relative to the foreground frame "
"[Default is ``(\"4p\", \"-4p\")``]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/params/box.py:docstring
#: of pygmt.params.Box.shade_fill:1
msgid "Fill for the shaded region [Default is ``\"gray50\"``]."
msgstr ""

