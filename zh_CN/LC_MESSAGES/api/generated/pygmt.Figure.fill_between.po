#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/fill_between.py:docstring
#: of pygmt.src.fill_between.fill_between:27
msgid "Pen attributes for the secondary curve."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/fill_between.py:docstring
#: of pygmt.src.fill_between.fill_between:29
msgid "Label for the primary curve, to be displayed in the legend."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/fill_between.py:docstring
#: of pygmt.src.fill_between.fill_between:31
