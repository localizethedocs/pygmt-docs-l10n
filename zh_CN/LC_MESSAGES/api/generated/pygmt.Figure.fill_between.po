msgid "Fill the area between two horizontal curves."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/fill_between.py:docstring
#: of pygmt.src.fill_between.fill_between:3
msgid ""
"This method is a high-level wrapper around :meth:`pygmt.Figure.plot` to fill "
"the area between a primary curve ``y(x)`` and a secondary curve ``y2(x)``. "
"The ``y2`` parameter can be either a single value [Default is 0] or a "
"sequence. It can share the same ``x`` coordinates as ``y`` or use a separate "
"``x2`` coordinate sequence."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/fill_between.py:docstring
#: of pygmt.src.fill_between.fill_between:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/fill_between.py:docstring
#: of pygmt.src.fill_between.fill_between:9
msgid "X-coordinates of the primary curve."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/fill_between.py:docstring
#: of pygmt.src.fill_between.fill_between:11
msgid "Y-coordinates of the primary curve."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/fill_between.py:docstring
#: of pygmt.src.fill_between.fill_between:13
msgid ""
"Y-coordinates of the secondary curve. It can be a scalar value for a "
"horizontal reference line, or a sequence with the same length as ``x`` and "
"``y`` when ``x2`` is not used. Default is 0."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/fill_between.py:docstring
#: of pygmt.src.fill_between.fill_between:17
msgid ""
"X-coordinates of the secondary curve. Use this parameter only when ``y2`` is "
"a sequence sampled at different x-coordinates from ``y``. In that case, "
"``y2`` must have the same length as ``x2``."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/fill_between.py:docstring
#: of pygmt.src.fill_between.fill_between:21
msgid ""
"Fill for areas where the primary curve is greater than the secondary curve."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/fill_between.py:docstring
#: of pygmt.src.fill_between.fill_between:23
msgid ""
"Fill for areas where the secondary curve is greater than the primary curve."
msgstr ""

