#: ../../../gallery/symbols/datetime_inputs.rst:22
msgid "Datetime inputs"
msgstr ""

#: ../../../gallery/symbols/datetime_inputs.rst:24
msgid "Datetime inputs of the following types are supported in PyGMT:"
msgstr ""

#: ../../../gallery/symbols/datetime_inputs.rst:26
msgid ":class:`numpy.datetime64`"
msgstr ""

#: ../../../gallery/symbols/datetime_inputs.rst:27
msgid ":class:`pandas.DatetimeIndex`"
msgstr ""

#: ../../../gallery/symbols/datetime_inputs.rst:28
msgid ":class:`xarray.DataArray`: datetimes included in an *xarray.DataArray*"
msgstr ""

#: ../../../gallery/symbols/datetime_inputs.rst:29
msgid ""
"raw datetime strings in `ISO 8601 format <https://en.wikipedia.org/wiki/"
"ISO_8601>`__ (e.g. ``\"YYYY-MM-DD\"``, ``\"YYYY-MM-DDTHH\"``, and ``\"YYYY-"
"MM-DDTHH:MM:SS\"``)"
msgstr ""

#: ../../../gallery/symbols/datetime_inputs.rst:32
msgid "Python built-in :class:`datetime.datetime` and :class:`datetime.date`"
msgstr ""

#: ../../../gallery/symbols/datetime_inputs.rst:34
msgid ""
"We can pass datetime inputs based on one of the types listed above directly "
"to the ``x`` and ``y`` parameters of e.g. the :meth:`pygmt.Figure.plot` "
"method."
msgstr ""

#: ../../../gallery/symbols/datetime_inputs.rst:37
msgid ""
"The ``region`` parameter has to include the :math:`x` and :math:`y` axis "
"limits in the form [*date_min*, *date_max*, *ymin*, *ymax*]. Here *date_min* "
"and *date_max* can be directly defined as datetime input."
msgstr ""

#: ../../../gallery/symbols/datetime_inputs.rst:43
msgid ""
"import datetime\n"
"\n"
"import numpy as np\n"
"import pandas as pd\n"
"import pygmt\n"
"import xarray as xr\n"
"from pygmt.params import Axis, Frame\n"
"\n"
"fig = pygmt.Figure()\n"
"\n"
"# create a basemap with limits of 2010-01-01 to 2020-06-01 on the x-axis "
"and\n"
"# 0 to 10 on the y-axis\n"
"fig.basemap(\n"
"    projection=\"X15c/5c\",\n"
"    region=[datetime.date(2010, 1, 1), datetime.date(2020, 6, 1), 0, 10],\n"
"    frame=Frame(axes=\"WSen\", axis=Axis(annot=True, tick=True)),\n"
")\n"
"\n"
"# numpy.datetime64 types\n"
"x = np.array(\n"
"    [\"2010-06-01\", \"2011-06-01T12\", \"2012-01-01T12:34:56\"], dtype=np."
"datetime64\n"
")\n"
"y = [1, 2, 3]\n"
"fig.plot(x=x, y=y, style=\"c0.4c\", pen=\"1p\", fill=\"red3\")\n"
"\n"
"# pandas.DatetimeIndex\n"
"x = pd.date_range(\"2013\", periods=3, freq=\"YS\")\n"
"y = [4, 5, 6]\n"
"fig.plot(x=x, y=y, style=\"t0.4c\", pen=\"1p\", fill=\"gold\")\n"
"\n"
"# xarray.DataArray\n"
"x = xr.DataArray(data=pd.date_range(start=\"2015-03\", periods=3, "
"freq=\"QS\"))\n"
"y = [7.5, 6, 4.5]\n"
"fig.plot(x=x, y=y, style=\"s0.4c\", pen=\"1p\")\n"
"\n"
"# raw datetime strings\n"
"x = [\"2016-02-01\", \"2016-06-04T14\", \"2016-10-04T00:00:15\"]\n"
"y = [7, 8, 9]\n"
"fig.plot(x=x, y=y, style=\"a0.4c\", pen=\"1p\", fill=\"dodgerblue\")\n"
"\n"
"# the Python built-in datetime and date\n"
"x = [datetime.date(2018, 1, 1), datetime.datetime(2019, 6, 1, 20, 5, 45)]\n"
"y = [6.5, 4.5]\n"
"fig.plot(x=x, y=y, style=\"i0.4c\", pen=\"1p\", fill=\"seagreen\")\n"
"\n"
"fig.show()"
msgstr ""

