#: ../../../tutorials/advanced/cartesian_histograms.rst:37
msgid "Import the required packages"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:41
msgid ""
"import numpy as np\n"
"import pygmt\n"
"from pygmt.params import Axis, Frame, Pattern"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:50
msgid "Generate random data from a normal distribution:"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:54
msgid ""
"rng = np.random.default_rng(seed=100)\n"
"\n"
"# Mean of distribution\n"
"mean = 100\n"
"# Standard deviation of distribution\n"
"stddev = 20\n"
"\n"
"# Create two data sets\n"
"data01 = rng.normal(loc=mean, scale=stddev, size=42)\n"
"data02 = rng.normal(loc=mean, scale=stddev * 2, size=42)"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:73
msgid "Vertical and horizontal bars"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:75
msgid ""
"To define the width of the bins, the ``series`` parameter has to be "
"specified. The bars can be filled via the ``fill`` parameter with either a "
"color or a pattern (see later in this tutorial). Use the ``pen`` parameter "
"to adjust width, color, and style of the outlines. By default, a histogram "
"with vertical bars is created. Horizontal bars can be achieved via "
"``horizontal=True``."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:83
msgid ""
"fig = pygmt.Figure()\n"
"\n"
"# Create histogram for data01 with vertical bars\n"
"fig.histogram(\n"
"    # Define the plot range as a list of xmin, xmax, ymin, ymax\n"
"    # Let ymin and ymax determined automatically by setting both to the same "
"value\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X10c\",  # Cartesian projection with a width of 10 "
"centimeters\n"
"    # Add frame, annotations (\"a\"), ticks (\"f\"), and y-axis label "
"(\"+l\") \"Counts\"; the\n"
"    # numbers give the steps of annotations and ticks\n"
"    frame=Frame(\n"
"        axes=\"WStr\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=1, tick=1, label=\"Counts\"),\n"
"    ),\n"
"    data=data01,\n"
"    # Set the bin width via the \"series\" parameter\n"
"    series=10,\n"
"    # Fill the bars with color \"red3\"\n"
"    fill=\"red3\",\n"
"    # Draw a 1-point thick, solid outline in \"darkgray\" around the bars\n"
"    pen=\"1p,darkgray,solid\",\n"
"    # Choose counts via the \"histtype\" parameter\n"
"    histtype=0,\n"
")\n"
"\n"
"# Shift plot origin by the figure width (\"w\") plus 2 centimeters to the "
"right\n"
"fig.shift_origin(xshift=\"w+2c\")\n"
"\n"
"# Create histogram for data01 with horizontal bars\n"
"fig.histogram(\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X10c\",\n"
"    frame=Frame(\n"
"        axes=\"WStr\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=1, tick=1, label=\"Counts\"),\n"
"    ),\n"
"    data=data01,\n"
"    series=10,\n"
"    fill=\"red3\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    histtype=0,\n"
"    # Use horizontal bars. Note that the x- and y-axes are flipped, with the "
"x-axis\n"
"    # plotted vertically and the y-axis plotted horizontally.\n"
"    horizontal=True,\n"
")\n"
"\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:141
msgid "Stair-steps"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:143
msgid ""
"A stair-step diagram can be created by setting ``stairs=True``. Then only "
"the outer outlines of the bars are drawn, and no internal bars are visible."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:148
msgid ""
"fig = pygmt.Figure()\n"
"\n"
"# Create histogram for data01\n"
"fig.histogram(\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X10c\",\n"
"    frame=Frame(\n"
"        axes=\"WSne\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=1, tick=1, label=\"Counts\"),\n"
"    ),\n"
"    data=data01,\n"
"    series=10,\n"
"    # Draw a 1-point thick, dotted outline in \"red3\"\n"
"    pen=\"1p,red3,dotted\",\n"
"    histtype=0,\n"
"    # Draw stair-steps in stead of bars\n"
"    stairs=True,\n"
")\n"
"\n"
"fig.shift_origin(xshift=\"w+2c\")\n"
"\n"
"# Create histogram for data02\n"
"fig.histogram(\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X10c\",\n"
"    frame=Frame(\n"
"        axes=\"WSne\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=1, tick=1, label=\"Counts\"),\n"
"    ),\n"
"    data=data02,\n"
"    series=10,\n"
"    # Draw a 1.5-point thick, dashed outline in \"orange\"\n"
"    pen=\"1.5p,orange,dashed\",\n"
"    histtype=0,\n"
"    stairs=True,\n"
")\n"
"\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:197
msgid "Counts and frequency percent"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:199
msgid ""
"By default, a histogram showing the counts in each bin is created "
"(``histtype=0``). To show the frequency percent set the ``histtype`` "
"parameter to ``1``. For further options please have a look at the "
"documentation of :meth:`pygmt.Figure.histogram`."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:205
msgid ""
"fig = pygmt.Figure()\n"
"\n"
"# Create histogram for data02 showing counts\n"
"fig.histogram(\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X10c\",\n"
"    frame=Frame(\n"
"        axes=\"WSnr\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=1, tick=1, label=\"Counts\"),\n"
"    ),\n"
"    data=data02,\n"
"    series=10,\n"
"    fill=\"orange\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    # Choose counts via the \"histtype\" parameter\n"
"    histtype=0,\n"
")\n"
"\n"
"fig.shift_origin(xshift=\"w+1c\")\n"
"\n"
"# Create histogram for data02 showing frequency percent\n"
"fig.histogram(\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X10c\",\n"
"    # Add suffix % (+u)\n"
"    frame=Frame(\n"
"        axes=\"lSnE\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=2, tick=1, unit=\"%\", label=\"Frequency "
"percent\"),\n"
"    ),\n"
"    data=data02,\n"
"    series=10,\n"
"    fill=\"orange\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    # Choose frequency percent via the \"histtype\" parameter\n"
"    histtype=1,\n"
")\n"
"\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:254
msgid "Cumulative values"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:256
msgid ""
"To create a histogram showing the cumulative values set ``cumulative=True``. "
"Here, the bars of the cumulative histogram are filled with a :class:`pygmt."
"params.Pattern` via the ``fill`` parameter. Annotate each bar with the "
"counts it represents using the ``annotate`` parameter."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:263
msgid ""
"fig = pygmt.Figure()\n"
"\n"
"# Create histogram for data01 showing the counts per bin\n"
"fig.histogram(\n"
"    region=[0, 200, 0, len(data01) + 1],\n"
"    projection=\"X10c\",\n"
"    frame=Frame(\n"
"        axes=\"WSne\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=5, tick=1, label=\"Counts\"),\n"
"    ),\n"
"    data=data01,\n"
"    series=10,\n"
"    fill=\"red3\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    histtype=0,\n"
"    # Annotate each bar with the counts it represents\n"
"    annotate=True,\n"
")\n"
"\n"
"fig.shift_origin(xshift=\"w+1c\")\n"
"\n"
"# Create histogram for data01 showing the cumulative counts\n"
"fig.histogram(\n"
"    region=[0, 200, 0, len(data01) + 1],\n"
"    projection=\"X10c\",\n"
"    frame=Frame(\n"
"        axes=\"wSnE\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=5, tick=1, label=\"Cumulative counts\"),\n"
"    ),\n"
"    data=data01,\n"
"    series=10,\n"
"    # Fill bars with GMT pattern 8, with white background and black "
"foreground.\n"
"    fill=Pattern(8, bgcolor=\"white\", fgcolor=\"black\"),\n"
"    pen=\"1p,darkgray,solid\",\n"
"    histtype=0,\n"
"    # Show cumulative counts\n"
"    cumulative=True,\n"
"    # Offset (\"+o\") the label by 10 points in negative y-direction\n"
"    annotate=\"+o-10p\",\n"
")\n"
"\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:316
msgid "Overlaid bars"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:318
msgid ""
"Overlaid or overlapping bars can be achieved by plotting two or several "
"histograms, each for one data set, on top of each other. The legend entry "
"can be specified via the ``label`` parameter."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:322
msgid "Limitations of histograms with overlaid bars are:"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:324
msgid "Mixing of colors or/and patterns"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:325
msgid "Visually more colors or/and patterns than data sets"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:326
msgid ""
"Visually a \"third histogram\" (or more in case of more than two data sets)"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:330
msgid ""
"fig = pygmt.Figure()\n"
"\n"
"# Create histogram for data01\n"
"fig.histogram(\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X10c\",\n"
"    frame=Frame(\n"
"        axes=\"WSne\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=1, tick=1, label=\"Counts\"),\n"
"    ),\n"
"    data=data01,\n"
"    series=10,\n"
"    fill=\"red3\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    histtype=0,\n"
"    # Set legend entry\n"
"    label=\"data01\",\n"
")\n"
"\n"
"# Create histogram for data02\n"
"# It is plotted on top of the histogram for data01\n"
"fig.histogram(\n"
"    data=data02,\n"
"    series=10,\n"
"    # Fill bars with color \"orange\", use a transparency of 50% (\"@50\")\n"
"    fill=\"orange@50\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    histtype=0,\n"
"    label=\"data02\",\n"
")\n"
"\n"
"# Add legend\n"
"fig.legend()\n"
"\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:375
msgid "Stacked bars"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:377
msgid ""
"Histograms with stacked bars are not directly supported by PyGMT. Thus, "
"before plotting, combined data sets have to be created from the single data "
"sets. Then, stacked bars can be achieved similar to overlaid bars via "
"plotting two or several histograms on top of each other."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:382
msgid "Limitations of histograms with stacked bars are:"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:384
msgid "No common baseline"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:385
msgid "Partly not directly clear whether overlaid or stacked bars"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:389
msgid ""
"# Combine the two data sets to one data set\n"
"data_merge = np.concatenate((data01, data02), axis=None)\n"
"\n"
"fig = pygmt.Figure()\n"
"\n"
"# Create histogram for data02 by using the combined data set\n"
"fig.histogram(\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X10c\",\n"
"    frame=Frame(\n"
"        axes=\"WSne\",\n"
"        xaxis=Axis(annot=True, tick=10),\n"
"        yaxis=Axis(annot=1, tick=1, label=\"Counts\"),\n"
"    ),\n"
"    data=data_merge,\n"
"    series=10,\n"
"    fill=\"orange\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    histtype=0,\n"
"    # The combined data set appears in the final histogram visually as data "
"set data02\n"
"    label=\"data02\",\n"
")\n"
"\n"
"# Create histogram for data01\n"
"# It is plotted on top of the histogram for data02\n"
"fig.histogram(\n"
"    data=data01,\n"
"    series=10,\n"
"    fill=\"red3\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    histtype=0,\n"
"    label=\"data01\",\n"
")\n"
"\n"
"# Add legend\n"
"fig.legend()\n"
"\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:436
msgid "Grouped bars"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:438
msgid ""
"By setting the ``bar_width`` parameter in respect to the values passed to "
"the ``series`` parameter histograms with grouped bars can be created."
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:441
msgid "Limitations of histograms with grouped bars are:"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:443
msgid ""
"Careful setting width and position of the bars in respect to the bin width"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:444
msgid "Difficult to see the variations of the single data sets"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:448
msgid ""
"# Width used for binning the data\n"
"binwidth = 10\n"
"\n"
"fig = pygmt.Figure()\n"
"\n"
"# Create histogram for data01\n"
"fig.histogram(\n"
"    region=[0, 200, 0, 0],\n"
"    projection=\"X10c\",\n"
"    frame=Frame(\n"
"        axes=\"WSne\",\n"
"        xaxis=Axis(annot=True, tick=10, grid=10),\n"
"        yaxis=Axis(annot=1, tick=1, label=\"Counts\"),\n"
"    ),\n"
"    data=data01,\n"
"    series=binwidth,\n"
"    fill=\"red3\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    histtype=0,\n"
"    # Calculate the bar width in respect to the bin width, here for two data "
"sets half\n"
"    # of the bin width\n"
"    bar_width=binwidth / 2,\n"
"    # Offset the bars to align each bar with the left limit of the "
"corresponding bin\n"
"    bar_offset=-binwidth / 4,\n"
"    label=\"data01\",\n"
")\n"
"\n"
"# Create histogram for data02\n"
"fig.histogram(\n"
"    data=data02,\n"
"    series=binwidth,\n"
"    fill=\"orange\",\n"
"    pen=\"1p,darkgray,solid\",\n"
"    histtype=0,\n"
"    bar_width=binwidth / 2,\n"
"    bar_offset=binwidth / 4,\n"
"    label=\"data02\",\n"
")\n"
"\n"
"# Add legend\n"
"fig.legend()\n"
"\n"
"fig.show()"
msgstr ""

