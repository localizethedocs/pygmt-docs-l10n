msgid ""
"Cartesian histograms can be generated using the :meth:`pygmt.Figure."
"histogram` method. In this tutorial, different histogram related aspects are "
"addressed:"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:27
msgid "Using vertical and horizontal bars"
msgstr ""

#: ../../../tutorials/advanced/cartesian_histograms.rst:28
msgid "Using stair-steps"
msgstr ""

