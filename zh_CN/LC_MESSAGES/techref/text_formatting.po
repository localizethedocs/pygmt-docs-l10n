#: ../../../techref/text_formatting.md:1
msgid "Text Formatting"
msgstr ""

#: ../../../techref/text_formatting.md:3
msgid ""
"The table below shows how text added to a plot, such as text strings added "
"via `Figure.text`, plot title, labels of Cartesian axes and colorbars, and "
"legend entries. Changing the font as well as its color and size in this way "
"allows to change those only for specific characters of a longer text. The "
"supported fonts are listed at [](/techref/fonts.md)."
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "Symbol"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "Behavior"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "@%*font*%*TEXT*@%%"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "Change the *font* of *TEXT*"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "@;*color*;*TEXT*@;;"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "Change the font *color* of *TEXT*"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "@:*size*:*TEXT*@::"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "Change the font *size* of *TEXT*"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "@-*TEXT*@-"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "Toggle subscripts on/off"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "@+*TEXT*@+"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "Toggle superscript on/off"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "@#*TEXT*@#"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "Toggle small caps on/off"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "@\\_*TEXT*@\\_"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "Toggle underline on/off"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "@!*CHAR1CHAR2*"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid ""
"Print two characters on top of each other (composite characters, e.g., "
"overstrike)"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "@\\~*TEXT*@\\~"
msgstr ""

#: ../../../techref/text_formatting.md:0
msgid "Toggle Greek letters on/off"
msgstr ""

