#: ../../../projections/cyl/cyl_miller.rst:22
msgid "Miller cylindrical projection"
msgstr ""

#: ../../../projections/cyl/cyl_miller.rst:24
msgid ""
"This cylindrical projection, presented by Osborn Maitland Miller of the "
"American Geographic Society in 1942, is neither equal nor conformal. All "
"meridians and parallels are straight lines. The projection was designed to "
"be a compromise between Mercator and other cylindrical projections. "
"Specifically, Miller spaced the parallels by using Mercator's formula with "
"0.8 times the actual latitude, thus avoiding the singular poles; the result "
"was then divided by 0.8."
msgstr ""

#: ../../../projections/cyl/cyl_miller.rst:32
msgid "**j**\\ [*lon0/*]\\ */scale* or **J**\\ [*lon0/*]\\ */width*"
msgstr ""

#: ../../../projections/cyl/cyl_miller.rst:34
msgid "**j** or **J**: Sets the projection type."
msgstr ""

#: ../../../projections/cyl/cyl_miller.rst:35
msgid "*lon0*: Sets the central meridian [Optional]."
msgstr ""

#: ../../../projections/cyl/cyl_miller.rst:36
msgid "*scale* or *width*: Sets the map size."
msgstr ""

#: ../../../projections/cyl/cyl_miller.rst:40
msgid ""
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"fig.coast(\n"
"    region=[-180, 180, -80, 80],\n"
"    projection=\"J-65/12c\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
"    land=\"gray80\",\n"
"    water=\"steelblue\",\n"
")\n"
"fig.show()"
msgstr ""

