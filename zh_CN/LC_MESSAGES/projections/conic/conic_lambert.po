#: ../../../projections/conic/conic_lambert.rst:22
msgid "Lambert conic conformal projection"
msgstr ""

#: ../../../projections/conic/conic_lambert.rst:24
msgid ""
"This conic projection was designed by the Alsatian mathematician Johann "
"Heinrich Lambert (1772) and has been used extensively for mapping of regions "
"with predominantly east-west orientation, just like the Albers projection. "
"Unlike the Albers projection, Lambert's conformal projection is not equal-"
"area. The parallels are arcs of circles with a common origin, and meridians "
"are the equally spaced radii of these circles. As with Albers projection, it "
"is only the two standard parallels that are distortion-free."
msgstr ""

#: ../../../projections/conic/conic_lambert.rst:32
msgid ""
"**l**\\ *lon0/lat0*\\ /\\ *lat1/lat2*\\ */scale* or **L**\\ *lon0/lat0*\\ /"
"\\ *lat1/lat2*\\ */width*"
msgstr ""

#: ../../../projections/conic/conic_lambert.rst:35
msgid "**l** or **L**: Sets the projection type."
msgstr ""

#: ../../../projections/conic/conic_lambert.rst:36
msgid "*lon0/lat0*: Sets the projection center."
msgstr ""

#: ../../../projections/conic/conic_lambert.rst:37
msgid "*lat1/lat2*: Sets the two standard parallels."
msgstr ""

#: ../../../projections/conic/conic_lambert.rst:38
msgid "*scale* or *width*: Sets the map size."
msgstr ""

