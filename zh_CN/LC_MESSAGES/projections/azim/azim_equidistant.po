#: ../../../projections/azim/azim_equidistant.rst:22
msgid "Azimuthal equidistant projection"
msgstr ""

#: ../../../projections/azim/azim_equidistant.rst:24
msgid ""
"The main advantage of this projection is that distances from the projection "
"center are displayed in correct proportions. Also directions measured from "
"the projection center are correct. It is very useful for a global view on "
"locations that lie within a certain distance or for comparing distances of "
"different locations relative to the projection center."
msgstr ""

#: ../../../projections/azim/azim_equidistant.rst:30
msgid ""
"**e**\\ *lon0/lat0*\\ [*/horizon*]\\ */scale* or **E**\\ *lon0/lat0*\\ [*/"
"horizon*]\\ */width*"
msgstr ""

#: ../../../projections/azim/azim_equidistant.rst:33
msgid "**e** or **E**: Sets the projection type."
msgstr ""

#: ../../../projections/azim/azim_equidistant.rst:34
msgid "*lon0/lat0*: Sets the projection center."
msgstr ""

#: ../../../projections/azim/azim_equidistant.rst:35
msgid ""
"*horizon*: The maximum distance from the projection center to the edge of "
"the map (i.e. the visible portion of the rest of the world map) in degrees "
"(<= 180°) [Optional, default is 180°]."
msgstr ""

#: ../../../projections/azim/azim_equidistant.rst:38
msgid "*scale* or *width*: Sets the map size."
msgstr ""

#: ../../../projections/azim/azim_equidistant.rst:42
msgid ""
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"fig.coast(\n"
"    region=\"g\",\n"
"    projection=\"E-100/40/15c\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
"    land=\"khaki\",\n"
"    water=\"white\",\n"
")\n"
"fig.show()"
msgstr ""

