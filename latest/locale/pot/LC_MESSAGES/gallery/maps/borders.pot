#: ../../../gallery/maps/borders.rst:22
msgid "Political boundaries"
msgstr ""

#: ../../../gallery/maps/borders.rst:24
msgid ""
"The ``borders`` parameter of :meth:`pygmt.Figure.coast` specifies levels of "
"political boundaries to plot and the pen used to draw them. Choose from the "
"list of boundaries below:"
msgstr ""

#: ../../../gallery/maps/borders.rst:28
msgid "**1** = National boundaries"
msgstr ""

#: ../../../gallery/maps/borders.rst:29
msgid "**2** = State boundaries within the Americas"
msgstr ""

#: ../../../gallery/maps/borders.rst:30
msgid "**3** = Marine boundaries"
msgstr ""

#: ../../../gallery/maps/borders.rst:31
msgid "**a** = All boundaries (1-3)"
msgstr ""

#: ../../../gallery/maps/borders.rst:33
msgid ""
"For example, to draw national boundaries with a line thickness of 1 point "
"and black line color use ``borders=\"1/1p,black\"``. You can draw multiple "
"boundaries by passing in a list to ``borders``."
msgstr ""

#: ../../../gallery/maps/borders.rst:39
msgid ""
"import pygmt\n"
"from pygmt.params import Axis\n"
"\n"
"fig = pygmt.Figure()\n"
"# Make a Sinusoidal projection map of the Americas with automatic "
"annotations,\n"
"# ticks and gridlines\n"
"fig.basemap(\n"
"    region=[-150, -30, -60, 60],\n"
"    projection=\"I-90/15c\",\n"
"    frame=Axis(annot=True, tick=True, grid=True),\n"
")\n"
"# Plot each level of the boundaries dataset with a different color.\n"
"fig.coast(borders=[\"1/0.5p,black\", \"2/0.5p,red\", \"3/0.5p,blue\"], "
"land=\"gray\")\n"
"fig.show()"
msgstr ""

