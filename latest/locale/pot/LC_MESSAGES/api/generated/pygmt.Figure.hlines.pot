#: ../../../api/generated/pygmt.Figure.hlines.rst:2
msgid "pygmt.Figure.hlines"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/hlines.py:docstring
#: of pygmt.src.hlines.hlines:1
msgid "Plot one or multiple horizontal line(s)."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/hlines.py:docstring
#: of pygmt.src.hlines.hlines:3
msgid ""
"This method is a high-level wrapper around :meth:`pygmt.Figure.plot` that "
"focuses on plotting horizontal lines at Y-coordinates specified by the ``y`` "
"parameter. The ``y`` parameter can be a single value (for a single "
"horizontal line) or a sequence of values (for multiple horizontal lines)."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/hlines.py:docstring
#: of pygmt.src.hlines.hlines:8
msgid ""
"By default, the X-coordinates of the start and end points of the lines are "
"set to be the X-limits of the current plot, but this can be overridden by "
"specifying the ``xmin`` and ``xmax`` parameters. ``xmin`` and ``xmax`` can "
"be either a single value or a sequence of values. If a single value is "
"provided, it is applied to all lines. If a sequence is provided, the length "
"of ``xmin`` and ``xmax`` must match the length of ``y``."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/hlines.py:docstring
#: of pygmt.src.hlines.hlines:15
msgid ""
"The term \"horizontal\" lines can be interpreted differently in different "
"coordinate systems:"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/hlines.py:docstring
#: of pygmt.src.hlines.hlines:18
msgid "**Cartesian**: lines are plotted as straight lines."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/hlines.py:docstring
#: of pygmt.src.hlines.hlines:19
msgid "**Polar**: lines are plotted as arcs along a constant radius."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/hlines.py:docstring
#: of pygmt.src.hlines.hlines:20
msgid ""
"**Geographic**: lines are plotted as arcs along parallels (i.e., constant "
"latitude)."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/hlines.py:docstring
#: of pygmt.src.hlines.hlines:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/hlines.py:docstring
#: of pygmt.src.hlines.hlines:24
msgid ""
"Y-coordinates to plot the lines. It can be a single value (for a single "
"line) or a sequence of values (for multiple lines)."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/hlines.py:docstring
#: of pygmt.src.hlines.hlines:26
msgid ""
"X-coordinates of the start/end point(s) of the line(s). If ``None``, "
"defaults to the X-limits of the current plot. ``xmin`` and ``xmax`` can be "
"either a single value or a sequence of values. If a single value is "
"provided, it is applied to all lines. If a sequence is provided, the length "
"of ``xmin`` and ``xmax`` must match the length of ``y``."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/hlines.py:docstring
#: of pygmt.src.hlines.hlines:32
msgid "Pen attributes for the line(s), in the format of *width,color,style*."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/hlines.py:docstring
#: of pygmt.src.hlines.hlines:34
msgid "Label for the line(s), to be displayed in the legend."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/hlines.py:docstring
#: of pygmt.src.hlines.hlines:36
msgid ""
"Do **not** clip lines outside the plot region. Only makes sense in the "
"Cartesian coordinate system. [Default is ``False`` to clip lines at the plot "
"region.]"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/hlines.py:docstring
#: of pygmt.src.hlines.hlines:39
msgid ""
"Select perspective view and set the azimuth and elevation angle of the "
"viewpoint. Refer to :meth:`pygmt.Figure.plot` for details."
msgstr ""

