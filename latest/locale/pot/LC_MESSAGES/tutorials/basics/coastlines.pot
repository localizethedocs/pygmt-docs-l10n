#: ../../../tutorials/basics/coastlines.rst:22
msgid "Coastlines and borders"
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:24
msgid ""
"Plotting coastlines and borders is handled by :meth:`pygmt.Figure.coast`."
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:28
msgid "import pygmt"
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:36
msgid "Shorelines"
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:38
msgid "Use the ``shorelines`` parameter to plot only the shorelines:"
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:42
msgid ""
"fig = pygmt.Figure()\n"
"fig.basemap(region=\"g\", projection=\"W15c\", frame=True)\n"
"fig.coast(shorelines=True)\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:53
msgid "The shorelines are divided in 4 levels:"
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:55
msgid "coastline"
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:56
msgid "lakeshore"
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:57
msgid "island-in-lake shore"
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:58
msgid "lake-in-island-in-lake shore"
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:60
msgid ""
"You can specify which level you want to plot by passing the level number and "
"a GMT pen configuration. For example, to plot just the coastlines with 0.5p "
"thickness and black lines:"
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:66
msgid ""
"fig = pygmt.Figure()\n"
"fig.basemap(region=\"g\", projection=\"W15c\", frame=True)\n"
"fig.coast(shorelines=\"1/0.5p,black\")\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:77
msgid ""
"You can specify multiple levels (with their own pens) by passing a list to "
"``shorelines``:"
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:82
msgid ""
"fig = pygmt.Figure()\n"
"fig.basemap(region=\"g\", projection=\"W15c\", frame=True)\n"
"fig.coast(shorelines=[\"1/1p,black\", \"2/0.5p,red\"])\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:95
msgid "Resolutions"
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:97
msgid ""
"The coastline database comes with 5 resolutions: ``\"full\"``, ``\"high\"``, "
"``\"intermediate\"``, ``\"low\"``, and ``\"crude\"``. The resolution drops "
"by 80% between levels. The ``resolution`` parameter defaults to ``\"auto\"`` "
"to automatically select the best resolution given the chosen map scale."
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:104
msgid ""
"oahu = [-158.3, -157.6, 21.2, 21.8]\n"
"fig = pygmt.Figure()\n"
"for res in [\"crude\", \"low\", \"intermediate\", \"high\", \"full\"]:\n"
"    fig.coast(resolution=res, shorelines=\"1p\", region=oahu, "
"projection=\"M5c\")\n"
"    fig.shift_origin(xshift=\"5c\")\n"
"fig.show()"
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:119
msgid "Land and water"
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:121
msgid ""
"Use the ``land`` and ``water`` parameters to specify a fill color for land "
"and water bodies. The colors can be given by name or hex codes (like the "
"ones used in HTML and CSS):"
msgstr ""

#: ../../../tutorials/basics/coastlines.rst:127
msgid ""
"fig = pygmt.Figure()\n"
"fig.basemap(region=\"g\", projection=\"W15c\", frame=True)\n"
"fig.coast(land=\"#666666\", water=\"skyblue\")\n"
"fig.show()"
msgstr ""

