#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:109
msgid ""
"*dx*/*dy*. Offset the plot symbol or line locations by the given amounts *dx/"
"dy* [Default is no offset]. If *dy* is not given it is set equal to *dx*."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:114
msgid ""
"[**x**\\|\\ **y**\\|\\ **X**\\|\\ **Y**][**+a**\\|\\ **A**] [**+cl**\\|\\ "
"**f**][**+n**][**+w**\\ *cap*][**+p**\\ *pen*]. Draw error bars. Full "
"documentation is at :gmt-docs:`plot.html#e`."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:119
msgid ""
"[**c**\\|\\ **n**\\|\\ **p**][**a**\\|\\ **r**\\|\\ **s**\\|\\ **t**\\|\\ "
"*refpoint*]. Alter the way points are connected (by specifying a *scheme*) "
"and data are grouped (by specifying a *method*). Append one of three line "
"connection schemes:  - **c**: Draw continuous line segments for each group "
"[Default]. - **n**: Draw networks of line segments between all points in "
"each group. - **p**: Draw line segments from a reference point reset for "
"each group.  Optionally, append the one of four segmentation methods to "
"define the group:  - **a**: Ignore all segment headers, i.e., let all points "
"belong to a single   group, and set group the reference point to the very "
"first point of the first   file. - **r**: Segment headers are honored so "
"each segment is a group; the group   reference point is reset after each "
"record to the previous point (this method   is only available with the "
"``connection=\"p\"`` scheme). - **s**: Same as **r**, but the group "
"reference point is reset to the first   point of each incoming segment "
"[Default]. - **t**: Consider all data in each file to be a single separate "
"group and reset   the group reference point to the first point of each "
"group.  Instead of the codes **a**\\|\\ **r**\\|\\ **s**\\|\\ **t** you may "
"append the coordinates of a *refpoint* which will serve as a fixed external "
"reference point for all groups."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:119
msgid ""
"[**c**\\|\\ **n**\\|\\ **p**][**a**\\|\\ **r**\\|\\ **s**\\|\\ **t**\\|\\ "
"*refpoint*]. Alter the way points are connected (by specifying a *scheme*) "
"and data are grouped (by specifying a *method*). Append one of three line "
"connection schemes:"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:123
msgid "**c**: Draw continuous line segments for each group [Default]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:124
msgid "**n**: Draw networks of line segments between all points in each group."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:125
msgid "**p**: Draw line segments from a reference point reset for each group."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:127
msgid ""
"Optionally, append the one of four segmentation methods to define the group:"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:129
msgid ""
"**a**: Ignore all segment headers, i.e., let all points belong to a single "
"group, and set group the reference point to the very first point of the "
"first file."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:132
msgid ""
"**r**: Segment headers are honored so each segment is a group; the group "
"reference point is reset after each record to the previous point (this "
"method is only available with the ``connection=\"p\"`` scheme)."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:135
msgid ""
"**s**: Same as **r**, but the group reference point is reset to the first "
"point of each incoming segment [Default]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:137
msgid ""
"**t**: Consider all data in each file to be a single separate group and "
"reset the group reference point to the first point of each group."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:140
msgid ""
"Instead of the codes **a**\\|\\ **r**\\|\\ **s**\\|\\ **t** you may append "
"the coordinates of a *refpoint* which will serve as a fixed external "
"reference point for all groups."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:144
msgid ""
"Set color or pattern for filling symbols or polygons [Default is no fill]. "
"*fill* can be a 1-D array, but it is only valid if using ``x``/``y`` and "
"``cmap=True`` is also required."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:149
msgid ""
"Provide an *intensity* value (nominally in the -1 to +1 range) to modulate "
"the fill color by simulating illumination. If using ``intensity=True``, we "
"will instead read *intensity* from the first data column after the symbol "
"parameters (if given). *intensity* can also be a 1-D array to set varying "
"intensity for symbols, but it is only valid for ``x``/``y`` pairs."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:156
msgid ""
"[**+b**\\|\\ **d**\\|\\ **D**][**+xl**\\|\\ **r**\\|\\ *x0*] [**+yl**\\|\\ "
"**r**\\|\\ *y0*][**+p**\\ *pen*]. Force closed polygons. Full documentation "
"is at :gmt-docs:`plot.html#l`."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:161
msgid ""
"[**c**\\|\\ **r**]. Do **not** clip symbols that fall outside the frame "
"boundaries [Default plots points whose coordinates are strictly inside the "
"frame boundaries only]. The parameter does not apply to lines and polygons "
"which are always clipped to the plot region. For periodic (360-longitude) "
"maps we must plot all symbols twice in case they are clipped by the "
"repeating boundary. ``no_clip=True`` will turn off clipping and not plot "
"repeating symbols. Use ``no_clip=\"r\"`` to turn off clipping but retain the "
"plotting of such repeating symbols, or use ``no_clip=\"c\"`` to retain "
"clipping but turn off plotting of repeating symbols."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:174
msgid ""
"Plot symbols (including vectors, pie slices, fronts, decorated or quoted "
"lines)."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:177
msgid "Set pen attributes for lines or the outline of symbols."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:179
msgid ""
"*value*\\|\\ *file*. Instead of specifying a symbol or polygon fill and "
"outline color via ``fill`` and ``pen``, give both a *value* via ``zvalue`` "
"and a color lookup table via ``cmap``.  Alternatively, give the name of a "
"*file* with one z-value (read from the last column) for each polygon in the "
"input data. To apply it to the fill color, use ``fill=\"+z\"``. To apply it "
"to the pen color, append **+z** to ``pen``."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:189
msgid ""
"*projcode*\\[*projparams*/]\\ *width*\\|\\ *scale*. Select map :doc:"
"`projection </projections/index>`."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:191
msgid ""
"*xmin/xmax/ymin/ymax*\\ [**+r**][**+u**\\ *unit*]. Specify the :doc:`region "
"</tutorials/basics/regions>` of interest."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:195
msgid ""
"Set frame and axes attributes for the plot. It can be a bool, ``\"none\"``, "
"a :class:`pygmt.params.Frame` or :class:`pygmt.params.Axis` object. Raw GMT "
"strings or sequences of strings are also supported for backward "
"compatibility. If ``frame=True``, the frame will be drawn with the default "
"attributes. If ``frame=\"none\"``, no frame will be drawn. Use a :class:"
"`pygmt.params.Frame` or :class:`pygmt.params.Axis` object for more control "
"over the attributes of the frame and axes. A tutorial is available at :doc:"
"`frame and axes attributes </tutorials/basics/frames>`. Full documentation "
"is at :gmt-docs:`gmt.html#b-full`."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:204
msgid "Select verbosity level [:term:`Full usage <verbose>`]."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:206
msgid ""
"[*col*\\ =]\\ *name*\\ [,...]. Control how aspatial data are handled during "
"input and output. Full documentation is at :gmt-docs:`gmt.html#aspatial-"
"full`."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/src/plot.py:docstring
#: of pygmt.src.plot.plot:210
