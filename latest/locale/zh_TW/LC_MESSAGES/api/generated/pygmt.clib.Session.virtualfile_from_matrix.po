#: ../../../api/generated/pygmt.clib.Session.virtualfile_from_matrix.rst:2
msgid "pygmt.clib.Session.virtualfile\\_from\\_matrix"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.virtualfile_from_matrix:1
msgid "Store a 2-D numpy array as a matrix inside a virtual file."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.virtualfile_from_matrix:3
msgid ""
"Use the virtual file name to pass in the data in your matrix to a GMT module."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.virtualfile_from_matrix:5
msgid ""
"Context manager (use in a ``with`` block). Yields the virtual file name that "
"you can pass as an argument to a GMT module call. Closes the virtual file "
"upon exit of the ``with`` block."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.virtualfile_from_matrix:9
msgid ""
"The virtual file will contain the array as a ``GMT_MATRIX`` data container "
"pretending to be a ``GMT_DATASET`` data container."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.virtualfile_from_matrix:12
msgid ""
"**Not meant for creating ``GMT_GRID``**. The grid requires more metadata "
"than just the data matrix. Use :meth:`pygmt.clib.Session."
"virtualfile_from_grid` instead."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.virtualfile_from_matrix:16
msgid ""
"Use this instead of creating the data container and virtual file by hand "
"with :meth:`pygmt.clib.Session.create_data`, :meth:`pygmt.clib.Session."
"put_matrix`, and :meth:`pygmt.clib.Session.open_virtualfile`."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.virtualfile_from_matrix:20
msgid ""
"The matrix must be C contiguous in memory. If it is not (e.g., it is a slice "
"of a larger array), the array will be copied to make sure it is."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.virtualfile_from_matrix:0
msgid "Parameters"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.virtualfile_from_matrix:24
msgid "The matrix that will be included in the GMT data container."
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.virtualfile_from_matrix:0
msgid "Yields"
msgstr ""

#: ../../../../../../.conda/lib/python3.14/site-packages/pygmt/clib/session.py:docstring
#: of pygmt.clib.session.Session.virtualfile_from_matrix:26
msgid ""
"*fname* -- The name of virtual file. Pass this as a file name argument to a "
"GMT module."
msgstr ""

