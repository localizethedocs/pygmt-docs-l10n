#: ../../../gallery/lines/line_custom_cpt.rst:22
msgid "Line colors with a custom CPT"
msgstr ""

#: ../../../gallery/lines/line_custom_cpt.rst:24
msgid ""
"The color of the lines made by :meth:`pygmt.Figure.plot` can be set "
"according to a custom CPT and assigned with the ``pen`` parameter."
msgstr ""

#: ../../../gallery/lines/line_custom_cpt.rst:27
msgid ""
"The custom CPT can be used by setting the plot command's ``cmap`` parameter "
"to ``True``. The ``zvalue`` parameter sets the z-value (color) to be used "
"from the custom CPT, and the line color is set as the z-value by using "
"**+z** when setting the ``pen`` color."
msgstr ""

#: ../../../gallery/lines/line_custom_cpt.rst:34
msgid ""
"import numpy as np\n"
"import pygmt\n"
"from pygmt.params import Axis, Frame\n"
"\n"
"# Create a list of values between 20 and 30 with 0.2 intervals\n"
"x = np.arange(start=20, stop=30, step=0.2)\n"
"\n"
"fig = pygmt.Figure()\n"
"fig.basemap(\n"
"    frame=Frame(axes=\"WSne\", axis=Axis(annot=True, tick=True)), "
"region=[20, 30, -10, 10]\n"
")\n"
"\n"
"# Create a custom CPT with the batlow CPT and 10 discrete z-values "
"(colors),\n"
"# use color_model=\"+c0-9\" to write the color palette in categorical format "
"and\n"
"# add labels (0) to (9) for the colorbar legend\n"
"pygmt.makecpt(cmap=\"SCM/batlow\", series=[0, 9, 1], color_model=\"+c0-9\")\n"
"\n"
"# Plot 10 lines and set a different z-value for each line\n"
"for zvalue in range(10):\n"
"    y = zvalue * np.sin(x)\n"
"    fig.plot(x=x, y=y, cmap=True, zvalue=zvalue, pen=\"thick,+z,-\")\n"
"\n"
"# Color bar to show the custom CPT and the associated z-values\n"
"fig.colorbar()\n"
"fig.show()"
msgstr ""

